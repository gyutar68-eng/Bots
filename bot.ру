        text = "📦 ИСТОРИЯ ЗАКАЗОВ:\n\n"
        for order in user_orders[-10:]:  # Последние 10 заказов
            if order.get("type") == "test":
                order_type = "🧪 ТЕСТ (0.1$)"
            elif order.get("type") == "free_sim":
                order_type = "🎁 БЕСПЛАТНО"
            else:
                order_type = f"📱 ПОДПИСИ {order.get('quantity', 1)}шт"
            
            status = "✅ ОПЛАЧЕН" if order.get("status") == "paid" else \
                    "⏳ ОЖИДАНИЕ" if order.get("status") == "pending_payment" else \
                    "📤 ЗАВЕРШЁН" if order.get("status") == "completed" else \
                    "❌ ОШИБКА" if order.get("status") == "error" else \
                    "🔍 ТЕСТОВЫЙ"
            
            text += f"Заказ #{order['order_id']}\n"
            text += f"Тип: {order_type}\n"
            if order.get('price_usd'):
                text += f"Сумма: {order['price_usd']}$\n"
            text += f"Статус: {status}\n"
            text += f"Дата: {order.get('date', '')[:16]}\n\n"
    
    keyboard = [[InlineKeyboardButton("◀️ Назад в меню", callback_data="back_to_menu")]]
    reply_markup = InlineKeyboardMarkup(keyboard)
    await query.edit_message_text(text, reply_markup=reply_markup)

