# ФУНКЦИИ ДЛЯ РАБОТЫ С ФАЙЛАМИ
# ============================================
async def generate_product_file(user_id, item, order_id):
    """Генерирует файл с товаром"""
    os.makedirs("products", exist_ok=True)
    
    filename = f"products/{item['product_name'].replace(' ', '_')}_{order_id}_{uuid.uuid4().hex[:8]}.txt"
    
    if item['category'] == 'test':
        content = f"""🧪 ТЕСТОВЫЙ ТОВАР

✅ Оплата прошла успешно!

Заказ #{order_id}
Дата: {datetime.now().strftime('%d.%m.%Y %H:%M:%S')}
Покупатель: {user_id}

Это тестовый файл. Если вы его получили - значит оплата работает!
"""
    else:
        content = f"""📦 ВАШ ТОВАР

Заказ #{order_id}
Товар: {item['product_name']}
Количество: {item['quantity']} шт
Дата: {datetime.now().strftime('%d.%m.%Y %H:%M:%S')}

🔑 ДАННЫЕ:
Логин: user_{user_id}
Пароль: {uuid.uuid4().hex[:12]}
Сервер: logs.example.com
"""
    
    async with aiofiles.open(filename, 'w', encoding='utf-8') as f:
        await f.write(content)
    
    return filename

async def send_product_file(update, context, user_id, file_path):
    """Отправляет файл пользователю"""
    try:
        from telegram import FSInputFile
        
        document = FSInputFile(file_path)
        await context.bot.send_document(
            chat_id=user_id,
            document=document,
            caption="✅ Ваш товар готов!"
        )
        
        os.remove(file_path)
        return True
    except Exception as e:
        logger.error(f"Ошибка отправки файла: {e}")
        return False

