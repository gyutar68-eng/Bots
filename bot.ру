async def clicker_menu(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    
    if 'clicker' not in context.user_data:
        context.user_data['clicker'] = {
            'clicks': 0,
            'last_reset': datetime.now(timezone.utc).isoformat(),
            'checkpoint': 0,
            'verification_pending': False,
            'last_reward': None
        }
    
    user_data = context.user_data['clicker']
    clicks = user_data['clicks']
    
    progress = int((clicks / CLICKS_REQUIRED) * 100)
    progress_bar = "▓" * (progress // 10) + "░" * (10 - (progress // 10))
    
    if clicks >= CLICKS_REQUIRED:
        if user_data.get('last_reward') and (datetime.now() - datetime.fromisoformat(user_data['last_reward'])).days < 7:
            reward_text = "\n⏳ Кулдаун 7 дней"
