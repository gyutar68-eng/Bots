async def process_ban(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    
    if user_id != ADMIN_ID:
        await update.message.reply_text("⛔ Доступ запрещён!")
        return ConversationHandler.END
    
    try:
        parts = update.message.text.strip().split(' ', 1)
        target_id = int(parts[0])
        reason = parts[1] if len(parts) > 1 else "Без причины"
        
        banned_users.add(target_id)
        
        try:
            await context.bot.send_message(
                chat_id=target_id,
                text=f"⛔ Вы были забанены!\nПричина: {reason}"
            )
        except:
            pass
        
        await update.message.reply_text(
            f"✅ Пользователь {target_id} забанен.\nПричина: {reason}"
        )
        
    except Exception as e:
        await update.message.reply_text(f"❌ Ошибка: {e}")
    
    fake_query = type('obj', (object,), {
        'from_user': type('obj', (object,), {'id': user_id}),
        'message': update.message,
        'answer': lambda: None
    })
    await admin_panel(Update(update.update_id, callback_query=fake_query), context)
    
    return ConversationHandler.END

