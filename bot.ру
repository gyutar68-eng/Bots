        await query.edit_message_text(
            f"💳 ОПЛАТА\n\n"
            f"💰 Сумма: {total_rub} RUB = {usdt_amount} USDT\n"
            f"📊 Курс: {current_rate:.2f} RUB/USDT\n\n"
            f"1. Нажми ОПЛАТИТЬ\n"
            f"2. Оплати в Crypto Bot\n"
            f"3. Нажми «Я ОПЛАТИЛ»\n\n"
            f"После оплаты вы получите PDF файл с логами.",
            reply_markup=reply_markup
