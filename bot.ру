async def create_crypto_invoice(amount, description, user_id):
    if not CP_TOKEN:
        return None
    
    headers = {
        "Crypto-Pay-API-Token": CP_TOKEN,
        "Content-Type": "application/json"
    }
    
    payload = {
        "asset": "USDT",
        "amount": str(amount),
        "description": description
    }
    
    try:
        async with aiohttp.ClientSession() as session:
            async with session.post(
                "https://pay.crypt.bot/api/createInvoice",
                headers=headers,
                json=payload,
                timeout=30
            ) as resp:
                if resp.status == 200:
                    data = await resp.json()
                    if data.get("ok"):
                        return data["result"]
    except:
        pass
    return None

# ============================================
# ПРОВЕРКА СТАТУСА
# ============================================
async def check_crypto_payment(invoice_id, user_id):
    if not CP_TOKEN:
        return False
    
    headers = {"Crypto-Pay-API-Token": CP_TOKEN}
    params = {"invoice_ids": invoice_id}
    
    try:
        async with aiohttp.ClientSession() as session:
            async with session.get(
                "https://pay.crypt.bot/api/getInvoices",
                headers=headers,
                params=params,
                timeout=30
            ) as resp:
                if resp.status == 200:
                    data = await resp.json()
                    if data.get("ok") and data.get("result", {}).get("items"):
                        invoice = data["result"]["items"][0]
                        if str(user_id) in invoice.get("description", ""):
                            return invoice.get("status") == "paid"
    except:
        pass
    return False

# ============================================
# ОФОРМЛЕНИЕ ЗАКАЗА
# ============================================
async def checkout(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    
    user_id = query.from_user.id
    user_cart = carts.get(user_id, [])
    
    if not user_cart:
        await query.edit_message_text("❌ Корзина пуста", reply_markup=InlineKeyboardMarkup([[
            InlineKeyboardButton("📦 В каталог", callback_data="catalog")
        ]]))
        return
    
    total_rub = sum(item['price'] for item in user_cart)
    
    if not CP_TOKEN:
        await query.edit_message_text("❌ Оплата недоступна", reply_markup=InlineKeyboardMarkup([[
            InlineKeyboardButton("◀️ Назад", callback_data="cart")
        ]]))
        return
    
    usdt_amount = await rub_to_usdt(total_rub)
    current_rate = await get_usdt_rate()
    
    if usdt_amount < 0.1:
        min_rub = int(0.1 * current_rate)
        await query.edit_message_text(
            f"❌ Минимум {min_rub} ₽ (0.1 USDT)",
            reply_markup=InlineKeyboardMarkup([[
                InlineKeyboardButton("◀️ Назад", callback_data="cart")
            ]])
        )
        return
    
    invoice = await create_crypto_invoice(
        amount=usdt_amount,
        description=f"Заказ {user_id}",
        user_id=user_id
    )
    
    if invoice and invoice.get("pay_url"):
        if "pending_payments" not in context.user_data:
            context.user_data["pending_payments"] = []
        
        context.user_data["pending_payments"].append({
            "invoice_id": invoice["invoice_id"],
            "pay_url": invoice["pay_url"],
            "amount_rub": total_rub,
            "amount_usdt": usdt_amount,
            "rate": current_rate,
            "cart": user_cart.copy(),
            "user_id": user_id
        })
        
        keyboard = [
            [InlineKeyboardButton("💳 ОПЛАТИТЬ", url=invoice["pay_url"])],
            [InlineKeyboardButton("✅ Я ОПЛАТИЛ", callback_data=f"check_{invoice['invoice_id']}")],
            [InlineKeyboardButton("◀️ Отмена", callback_data="cart")]
        ]
        reply_markup = InlineKeyboardMarkup(keyboard)
        
        await query.edit_message_text(
            f"💳 ОПЛАТА\n\n"
            f"💰 {total_rub} RUB = {usdt_amount} USDT\n"
            f"📊 Курс: {current_rate:.2f} RUB/USDT\n\n"
            f"1. Нажми ОПЛАТИТЬ\n"
            f"2. Нажми «Я ОПЛАТИЛ»",
            reply_markup=reply_markup
        )
    else:
        await query.edit_message_text(
            "❌ Ошибка создания счёта.\n\nПоддержка: @shoplogs24support",
            reply_markup=InlineKeyboardMarkup([[
                InlineKeyboardButton("◀️ Назад", callback_data="cart")
            ]])
        )

# ============================================
# ПРОВЕРКА ОПЛАТЫ И ВЫДАЧА CSV
# ============================================
async def check_payment_callback(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    
    invoice_id = int(query.data.split("_")[1])
    user_id = query.from_user.id
    
    payment_info = None
    if "pending_payments" in context.user_data:
        for p in context.user_data["pending_payments"]:
            if p["invoice_id"] == invoice_id and p["user_id"] == user_id:
                payment_info = p
                break
    
    if not payment_info:
        await query.answer("❌ Платёж не найден", show_alert=True)
        return
    
    is_paid = await check_crypto_payment(invoice_id, user_id)
    
    if is_paid:
        await query.edit_message_text("✅ Платёж подтверждён! Формируем файл...")
        
        order_id = len(orders.get(user_id, [])) + 1
        if user_id not in orders:
            orders[user_id] = []
        
        orders[user_id].append({
            "order_id": order_id,
            "items": payment_info["cart"],
            "total_rub": payment_info["amount_rub"],
            "total_usdt": payment_info["amount_usdt"],
            "status": "Оплачен",
            "date": datetime.now().isoformat()
        })
        
        quantity = payment_info["cart"][0]["quantity"] if payment_info["cart"] else 1
        csv_path = await generate_logs_csv(user_id, order_id, quantity)
        
        from telegram import FSInputFile
        document = FSInputFile(csv_path)
        await context.bot.send_document(
            chat_id=user_id,
            document=document,
            caption=f"✅ Заказ #{order_id}\n\nЛоги ({quantity} шт)\n\nПоддержка: @shoplogs24support"
        )
        
        os.remove(csv_path)
        
        carts[user_id] = []
        context.user_data["pending_payments"].remove(payment_info)
        
        await context.bot.send_message(
            chat_id=user_id,
            text=f"✅ Заказ выполнен! Файл отправлен.",
            reply_markup=InlineKeyboardMarkup([[
                InlineKeyboardButton("📦 В каталог", callback_data="catalog")
            ]])
        )
    else:
        await query.answer("⏳ Платёж не найден или не оплачен", show_alert=True)

