def get_next_reset_time():
    """Возвращает следующее время сброса (сегодня в 13:00 МСК или завтра если уже прошло)"""
    now = datetime.now(timezone.utc)
    reset_time = now.replace(hour=RESET_HOUR, minute=RESET_MINUTE, second=0, microsecond=0)
    
    if now >= reset_time:
        reset_time += timedelta(days=1)
    
    return reset_time

def format_time_remaining(seconds):
    """Форматирует оставшееся время"""
    hours = seconds // 3600
    minutes = (seconds % 3600) // 60
    return f"{hours}ч {minutes}м"

async def reset_clicks_if_needed(user_id):
    """Сбрасывает клики если наступило время сброса"""
    if user_id not in clicker_data:
        return
    
    user_data = clicker_data[user_id]
    now = datetime.now(timezone.utc)
    
    # Проверяем не пора ли сбросить
    if 'last_reset' in user_data:
        last_reset = datetime.fromisoformat(user_data['last_reset'])
        # Если последний сброс был до сегодняшнего времени сброса
        today_reset = now.replace(hour=RESET_HOUR, minute=RESET_MINUTE, second=0, microsecond=0)
        if last_reset < today_reset and now >= today_reset:
            user_data['clicks'] = 0
            user_data['last_reset'] = now.isoformat()
            user_data['checkpoint'] = 0
            user_data['verification_pending'] = False
            logger.info(f"Клики сброшены для пользователя {user_id}")

async def check_weekly_cooldown(user_id):
    """Проверяет, прошла ли неделя с последнего получения бесплатной подписи"""
    if user_id not in clicker_data:
        return True
    
    user_data = clicker_data[user_id]
    if 'last_free_reward' not in user_data:
        return True
    
    last_reward = datetime.fromisoformat(user_data['last_free_reward'])
    now = datetime.now(timezone.utc)
    
    return (now - last_reward).total_seconds() > 7 * 24 * 3600  # 7 дней

async def generate_captcha():
