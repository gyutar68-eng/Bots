def check_bonus_reset(user_data):
    if 'bonus' not in user_data:
        return True
    
    now = datetime.now()
    
    if now.weekday() == BONUS_RESET_DAY and now.hour >= BONUS_RESET_HOUR:
        last_claim = user_data['bonus'].get('last_claim')
        if last_claim:
            last_claim_date = datetime.fromisoformat(last_claim)
            if last_claim_date.weekday() != BONUS_RESET_DAY or last_claim_date.hour < BONUS_RESET_HOUR:
                return True
        else:
            return True
    
    return False

