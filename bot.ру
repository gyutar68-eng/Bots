async def check_payment_callback(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    
    invoice_id = int(query.data.split("_")[2])
    user_id = query.from_user.id
    
    payment_info = None
    if "pending_payments" in context.user_data:
        for p in context.user_data["pending_payments"]:
            if p["invoice_id"] == invoice_id and p["user_id"] == user_id:
                payment_info = p
                break
    
    if not payment_info:
        await query.answer("❌ Платёж не найден", show_alert=True)
        return
    
    is_paid = await check_crypto_payment(invoice_id, user_id)
    
    if is_paid:
        if user_id in pending_orders:
            for order in pending_orders[user_id]:
                if order.get("order_id") == payment_info.get("order_id"):
                    order["status"] = "paid"
                    break
        
        if payment_info["type"] == "market":
            item_id = payment_info["item_id"]
            if item_id in market_items:
                seller_id = market_items[item_id]['seller_id']
                seller_earnings = payment_info['amount_usd'] * (1 - PLATFORM_COMMISSION)
                
                if seller_id not in user_balances:
                    user_balances[seller_id] = 0
                user_balances[seller_id] += seller_earnings
                
                del market_items[item_id]
                
                await query.edit_message_text(
                    f"✅ **Платёж подтверждён!**\n\n"
                    f"Товар #{item_id} оплачен.\n"
                    f"Средства переведены продавцу.\n\n"
                    f"Скоро вы получите данные от продавца.",
                    reply_markup=InlineKeyboardMarkup([[
                        InlineKeyboardButton("📋 К списку", callback_data="market_list")
                    ]]),
                    parse_mode='Markdown'
                )
                
                context.user_data["pending_payments"].remove(payment_info)
                return
            else:
                await query.edit_message_text(
                    "❌ Товар уже не найден.\n\nОбратитесь в поддержку @YungTrezinny",
                    reply_markup=InlineKeyboardMarkup([[
                        InlineKeyboardButton("◀️ В меню", callback_data="back_to_menu")
                    ]])
                )
                context.user_data["pending_payments"].remove(payment_info)
                return
        
        context.user_data["current_order"] = {
            "order_id": payment_info["order_id"],
            "type": payment_info["type"],
            "quantity": payment_info["quantity"],
            "user_id": user_id
        }
        
        keyboard = [[InlineKeyboardButton("❌ Отмена", callback_data="cancel_input")]]
        reply_markup = InlineKeyboardMarkup(keyboard)
        
        product_text = "ТЕСТОВЫЙ ТОВАР" if payment_info["type"] == "test" else f"{payment_info['quantity']} ПОДПИСИ(ЕЙ)"
        
        await query.edit_message_text(
            f"✅ **Платёж подтверждён!**\n\n"
            f"Теперь отправьте сид-фразу(ы) для {product_text}.\n\n"
            f"📌 **ПРИМЕР сид-фразы:**\n"
            f"`123456789012345678`\n\n"
            f"Если покупаете несколько, отправляйте каждую с новой строки.",
            reply_markup=reply_markup,
            parse_mode='Markdown'
        )
        
        context.user_data["pending_payments"].remove(payment_info)
        return WAITING_FOR_SIM_SEED
        
    else:
        await query.answer("⏳ Платёж не найден или не оплачен", show_alert=True)

