# КОРЗИНА
# ============================================
async def cart(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    
    user_id = query.from_user.id
    user_cart = carts.get(user_id, [])
    
    if not user_cart:
        keyboard = [[InlineKeyboardButton("📦 В каталог", callback_data="catalog")]]
        await query.edit_message_text("🛒 Корзина пуста", reply_markup=InlineKeyboardMarkup(keyboard))
        return
    
    total = 0
    text = "🛒 КОРЗИНА:\n\n"
    keyboard = []
    
    for i, item in enumerate(user_cart):
        text += f"{i+1}. {item['product_name']} - {item['price']} ₽\n"
        total += item['price']
        keyboard.append([InlineKeyboardButton(f"❌ Удалить {i+1}", callback_data=f"remove_{i}")])
    
    text += f"\n💰 ИТОГО: {total} ₽"
    keyboard.append([InlineKeyboardButton("✅ Оформить", callback_data="checkout")])
    keyboard.append([InlineKeyboardButton("📦 В каталог", callback_data="catalog")])
    
    await query.edit_message_text(text, reply_markup=InlineKeyboardMarkup(keyboard))

