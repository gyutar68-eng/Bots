def main():
    app = Application.builder().token(TOKEN).build()
    
    # ConversationHandler для ввода сид-фразы
    conv_handler = ConversationHandler(
        entry_points=[
            CallbackQueryHandler(test_sim, pattern="^test_sim$"),
            CallbackQueryHandler(check_payment_callback, pattern="^check_payment_[0-9]+$")
        ],
        states={
            WAITING_FOR_SIM_SEED: [
                MessageHandler(filters.TEXT & ~filters.COMMAND, handle_sim_seed),
                CallbackQueryHandler(cancel_input, pattern="^cancel_input$")
            ]
        },
        fallbacks=[CommandHandler("cancel", cancel_input)]
    )
    
    app.add_handler(conv_handler)
    
    # Команда /start
    app.add_handler(CommandHandler("start", start))
    
    # Обработчики callback-запросов
    app.add_handler(CallbackQueryHandler(check_subscription_callback, pattern="check_sub"))
