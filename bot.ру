async def create_crypto_invoice(amount, description, user_id, context=None):
    """Создаёт счёт в Crypto Bot"""
    if not CP_TOKEN:
        logger.error("❌ НЕТ CP_TOKEN!")
        return None
    
    headers = {
        "Crypto-Pay-API-Token": CP_TOKEN,
        "Content-Type": "application/json"
    }
    
    # Получаем username бота
    bot_username = "your_bot"
    if context:
        try:
            bot_info = await context.bot.get_me()
            bot_username = bot_info.username
        except:
            pass
    
    payload = {
        "asset": "USDT",
        "amount": str(amount),
        "description": f"Заказ #{user_id}",  # Здесь сохраняем ID пользователя
        "paid_btn_name": "callback",
        "paid_btn_url": f"https://t.me/{bot_username}",
        "allow_comments": False,
        "allow_anonymous": False
    }
    
    try:
        async with aiohttp.ClientSession() as session:
            # Пробуем mainnet
            async with session.post(
                "https://pay.crypt.bot/api/createInvoice",
                headers=headers,
                json=payload,
                timeout=30
            ) as resp:
                if resp.status == 200:
                    data = await resp.json()
                    if data.get("ok"):
                        logger.info(f"✅ Счёт создан для user {user_id}")
                        return data["result"]
                # Если не сработало - пробуем testnet
                async with session.post(
                    "https://testnet-pay.crypt.bot/api/createInvoice",
                    headers=headers,
                    json=payload,
                    timeout=30
                ) as resp2:
                    if resp2.status == 200:
                        data2 = await resp2.json()
                        if data2.get("ok"):
                            logger.info(f"✅ Счёт создан в TESTNET для user {user_id}")
                            return data2["result"]
    except Exception as e:
        logger.error(f"Ошибка создания счёта: {e}")
    
    return None

# ============================================
# ФУНКЦИЯ ПРОВЕРКИ СТАТУСА ОПЛАТЫ
# ============================================
async def check_crypto_payment(invoice_id, user_id):
    """Проверяет статус оплаты"""
    if not CP_TOKEN:
        return False
    
    headers = {"Crypto-Pay-API-Token": CP_TOKEN}
    params = {"invoice_ids": invoice_id}
    
    try:
        async with aiohttp.ClientSession() as session:
            # Пробуем mainnet
            async with session.get(
                "https://pay.crypt.bot/api/getInvoices",
                headers=headers,
                params=params,
                timeout=30
            ) as resp:
                if resp.status == 200:
                    data = await resp.json()
                    if data.get("ok") and data.get("result", {}).get("items"):
                        invoice = data["result"]["items"][0]
                        # Проверяем, что это счёт нашего пользователя
                        if f"#{user_id}" in invoice.get("description", ""):
                            return invoice.get("status") == "paid"
            
            # Пробуем testnet
            async with session.get(
                "https://testnet-pay.crypt.bot/api/getInvoices",
                headers=headers,
                params=params,
                timeout=30
            ) as resp2:
                if resp2.status == 200:
                    data2 = await resp2.json()
                    if data2.get("ok") and data2.get("result", {}).get("items"):
                        invoice2 = data2["result"]["items"][0]
                        if f"#{user_id}" in invoice2.get("description", ""):
                            return invoice2.get("status") == "paid"
    except Exception as e:
        logger.error(f"Ошибка проверки: {e}")
    
    return False

