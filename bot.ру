async def open_case_balance(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    user_id = query.from_user.id
    
    if user_id in banned_users:
        await query.answer("⛔ Вы забанены!", show_alert=True)
        return
    
    case_id = query.data.replace("open_balance_", "")
    case = CASES.get(case_id)
    
    if not case:
        return
    
    if case_id == 'free':
        last_open = case_cooldowns.get(user_id)
        if last_open:
            time_diff = datetime.now() - last_open
            if time_diff.days < 3:
                remaining = timedelta(days=3) - time_diff
                hours = remaining.seconds // 3600
                minutes = (remaining.seconds % 3600) // 60
                await query.answer(
                    f"⏳ Следующий бесплатный кейс через {hours}ч {minutes}м",
                    show_alert=True
                )
                return
    
    if case['price'] > 0:
        if user_balances.get(user_id, 0) < case['price']:
            await query.answer("❌ Недостаточно средств на балансе!", show_alert=True)
            return
        user_balances[user_id] -= case['price']
    
    if user_id not in user_stats:
        user_stats[user_id] = {
            'spent': 0,
            'opened_cases': 0,
            'won': 0,
            'nickname': query.from_user.first_name,
            'join_date': datetime.now().isoformat()
        }
    
    if case['price'] > 0:
        transactions.append({
            'user_id': user_id,
            'type': 'case_purchase',
            'case': case['name'],
            'amount': case['price'],
            'date': datetime.now().isoformat()
        })
        user_stats[user_id]['spent'] += case['price']
        user_stats[user_id]['opened_cases'] += 1
    
