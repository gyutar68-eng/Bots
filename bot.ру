async def handle_captcha_answer(update: Update, context: ContextTypes.DEFAULT_TYPE):
    answer = update.message.text.strip()
    captcha = context.user_data.get('captcha', {})
    
    if answer == captcha.get('answer', ''):
        if 'clicker' in context.user_data:
            context.user_data['clicker']['verification_pending'] = False
        
        context.user_data.pop('captcha', None)
        
        await update.message.reply_text("✅ Проверка пройдена!")
        
        fake_query = type('obj', (object,), {
            'from_user': type('obj', (object,), {'id': update.effective_user.id}),
            'message': update.message,
            'answer': lambda: None
        })
        await clicker_menu(Update(update.update_id, callback_query=fake_query), context)
    else:
        await update.message.reply_text(
            f"❌ Неправильно.\n"
            f"Вопрос: {captcha.get('question', '')}\n"
            f"Попробуй снова:"
        )
    
    return WAITING_FOR_CAPTCHA

