    try:
        args = context.args
        if len(args) < 1:
            await update.message.reply_text("❌ Формат: /endchat user_id")
            return
        
        user_id = int(args[0])
        
        if user_id in support_chats and support_chats[user_id].get('active', False):
            support_chats[user_id]['active'] = False
            support_chats[user_id]['closed_by'] = 'admin'
            support_chats[user_id]['closed_at'] = datetime.now().isoformat()
            
            await context.bot.send_message(
                chat_id=user_id,
                text="📩 Чат с поддержкой был закрыт администратором."
            )
            
            await update.message.reply_text(f"✅ Чат с пользователем {user_id} закрыт.")
        else:
            await update.message.reply_text(f"❌ У пользователя {user_id} нет активного чата.")
            
    except Exception as e:
        await update.message.reply_text(f"❌ Ошибка: {e}")

