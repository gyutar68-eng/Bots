def check_bonus_reset(user_data):
    if 'bonus' not in user_data:
        return True
    
    last_bonus = datetime.fromisoformat(user_data['bonus'].get('last_claim', '2000-01-01'))
    now = datetime.now()
    
    if now.weekday() == BONUS_RESET_DAY and now.hour >= BONUS_RESET_HOUR:
        if last_bonus.weekday() != BONUS_RESET_DAY or last_bonus.hour < BONUS_RESET_HOUR:
            return True
    
    return False

