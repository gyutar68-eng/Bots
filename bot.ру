# ============================================
# ФУНКЦИЯ СОЗДАНИЯ PDF С ЛОГАМИ
# ============================================
async def generate_logs_pdf(user_id, order_id, quantity):
    os.makedirs("products", exist_ok=True)
    
    filename = f"products/logs_{order_id}_{user_id}.pdf"
    
    from reportlab.pdfgen import canvas
    from reportlab.lib.pagesizes import A4
    from reportlab.lib.units import mm
    
    c = canvas.Canvas(filename, pagesize=A4)
    width, height = A4
    
    c.setFont("Helvetica-Bold", 16)
    c.drawString(30 * mm, height - 20 * mm, f"ЛОГИ - Заказ #{order_id}")
    
    c.setFont("Helvetica", 10)
    c.drawString(30 * mm, height - 30 * mm, f"Дата: {datetime.now().strftime('%d.%m.%Y %H:%M:%S')}")
    c.drawString(30 * mm, height - 35 * mm, f"Покупатель ID: {user_id}")
    c.drawString(30 * mm, height - 40 * mm, f"Количество: {quantity} шт")
    c.drawString(30 * mm, height - 45 * mm, f"Всего записей: 200")
    
    lines = LOGS_DATA.strip().split('\n')
    
    y = height - 70 * mm
    line_height = 5 * mm
    
    c.setFont("Helvetica-Bold", 10)
    c.drawString(10 * mm, y, "ФИО")
    c.drawString(70 * mm, y, "Телефон")
    c.drawString(120 * mm, y, "Дата рождения")
    c.drawString(170 * mm, y, "ID")
    
    y -= line_height * 2
    c.setFont("Helvetica", 8)
    
    for i, line in enumerate(lines[:200]):
        parts = line.split(',')
        if len(parts) == 4:
            name, phone, birth, uid = parts
            
            c.drawString(10 * mm, y, name[:30] + "..." if len(name) > 30 else name)
            c.drawString(70 * mm, y, phone)
            c.drawString(120 * mm, y, birth)
            c.drawString(170 * mm, y, uid)
            
            y -= line_height
            
            if y < 20 * mm:
                c.showPage()
                y = height - 20 * mm
                c.setFont("Helvetica-Bold", 16)
                c.drawString(30 * mm, y, f"ЛОГИ - Заказ #{order_id} (продолжение)")
                y -= 20 * mm
                c.setFont("Helvetica", 8)
    
    c.save()
    return filename

# ============================================
# УПРОЩЁННАЯ ФУНКЦИЯ СОЗДАНИЯ СЧЁТА
# ============================================
async def create_crypto_invoice(amount, description, user_id, context=None):
    if not CP_TOKEN:
        logger.error("❌ НЕТ CP_TOKEN!")
        return None
    
    headers = {
        "Crypto-Pay-API-Token": CP_TOKEN,
        "Content-Type": "application/json"
    }
    
    payload = {
        "asset": "USDT",
        "amount": str(amount),
        "description": description
    }
    
    logger.info(f"Создаём счёт для user {user_id} на {amount} USDT")
    
    try:
        async with aiohttp.ClientSession() as session:
            async with session.post(
                "https://pay.crypt.bot/api/createInvoice",
                headers=headers,
                json=payload,
                timeout=30
            ) as resp:
                if resp.status == 200:
                    data = await resp.json()
                    if data.get("ok"):
                        logger.info(f"✅ Счёт создан: {data['result']['invoice_id']}")
                        return data["result"]
                    else:
                        logger.error(f"Ошибка API: {data}")
                else:
                    text = await resp.text()
                    logger.error(f"HTTP {resp.status}: {text}")
    except Exception as e:
        logger.error(f"Ошибка создания счёта: {type(e).__name__}: {e}")
    
    return None

# ============================================
# ФУНКЦИЯ ПРОВЕРКИ СТАТУСА ОПЛАТЫ
# ============================================
async def check_crypto_payment(invoice_id, user_id):
    if not CP_TOKEN:
        return False
    
    headers = {"Crypto-Pay-API-Token": CP_TOKEN}
    params = {"invoice_ids": invoice_id}
    
    try:
        async with aiohttp.ClientSession() as session:
            async with session.get(
                "https://pay.crypt.bot/api/getInvoices",
                headers=headers,
                params=params,
                timeout=30
            ) as resp:
                if resp.status == 200:
                    data = await resp.json()
                    if data.get("ok") and data.get("result", {}).get("items"):
                        invoice = data["result"]["items"][0]
                        if str(user_id) in invoice.get("description", ""):
                            return invoice.get("status") == "paid"
    except Exception as e:
        logger.error(f"Ошибка проверки: {e}")
    
    return False

