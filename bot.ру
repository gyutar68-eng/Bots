async def faq_section_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    
    section_id = query.data.replace("faq_", "")
    section = next((s for s in FAQ_SECTIONS if str(s["id"]) == section_id), None)
    
    if section:
        if "faq_progress" not in context.user_data:
            context.user_data["faq_progress"] = {}
        context.user_data["faq_progress"][section_id] = True
        
        # Форматируем текст с подстановкой channel_url
        content = section["content"].format(channel_url=CHANNEL_URL)
        
        keyboard = [[InlineKeyboardButton("◀️ Назад к FAQ", callback_data="back_to_faq")]]
        reply_markup = InlineKeyboardMarkup(keyboard)
        await query.edit_message_text(content, reply_markup=reply_markup)

# ============================================
# НАПОМИНАНИЕ
# ============================================
async def faq_reminder_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    read_count = sum(1 for v in context.user_data.get("faq_progress", {}).values() if v)
    total = len(FAQ_SECTIONS)
    remaining = total - read_count
    await query.answer(f"❌ Осталось прочитать {remaining} разделов!", show_alert=True)

