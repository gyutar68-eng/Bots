    app.add_handler(CallbackQueryHandler(category_logs, pattern="category_logs"))
    app.add_handler(CallbackQueryHandler(category_test, pattern="category_test"))
    app.add_handler(CallbackQueryHandler(cart, pattern="cart"))
    app.add_handler(CallbackQueryHandler(orders_history, pattern="orders"))
