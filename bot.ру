async def show_faq(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    
    if "faq_progress" not in context.user_data:
        context.user_data["faq_progress"] = {str(section["id"]): False for section in FAQ_SECTIONS}
    
    progress = context.user_data["faq_progress"]
    read_count = sum(1 for v in progress.values() if v)
    total = len(FAQ_SECTIONS)
    
    keyboard = []
    for section in FAQ_SECTIONS:
        section_id = str(section["id"])
        is_read = progress.get(section_id, False)
        emoji = "✅" if is_read else "🔗"
        button_text = f"{emoji} {section['name']}"
        keyboard.append([InlineKeyboardButton(button_text, callback_data=f"faq_{section_id}")])
    
    if read_count == total:
        keyboard.append([InlineKeyboardButton("✅ ВСЁ ПРОЧИТАНО! Перейти в магазин", callback_data="go_to_shop")])
    else:
        keyboard.append([InlineKeyboardButton(f"✖️ Прочитайте все разделы ({read_count}/{total})", callback_data="faq_reminder")])
    
    reply_markup = InlineKeyboardMarkup(keyboard)
    
    text = f"📋 FAQ\n\n✔️ Прочитано: {read_count}/{total} разделов\n\nВыберите раздел:"
    
    if update.callback_query:
        await update.callback_query.edit_message_text(text, reply_markup=reply_markup)
    else:
        await update.message.reply_text(text, reply_markup=reply_markup)

