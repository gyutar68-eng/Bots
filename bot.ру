async def process_promo(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    promo_name = update.message.text.strip().upper()
    
    promo_codes = context.bot_data.get('promo_codes', {})
    
    if promo_name in promo_codes:
        promo = promo_codes[promo_name]
        
        if promo['uses_left'] <= 0:
            await update.message.reply_text("❌ Промокод использован!")
        elif user_id in promo['activated_by']:
            await update.message.reply_text("❌ Ты уже активировал!")
        else:
            promo['uses_left'] -= 1
            promo['activated_by'].append(user_id)
            
            context.user_data['balance'] = context.user_data.get('balance', 0) + promo['amount']
            
            await update.message.reply_text(
                f"✅ **АКТИВИРОВАН!**\n"
                f"💰 +{promo['amount']}$\n"
                f"💵 Баланс: {context.user_data['balance']}$"
            )
    else:
        await update.message.reply_text("❌ Промокод не найден!")
    
    fake_query = type('obj', (object,), {
        'from_user': type('obj', (object,), {'id': user_id}),
        'message': update.message,
        'answer': lambda: None
    })
    await profile_menu(Update(update.update_id, callback_query=fake_query), context)
    return ConversationHandler.END

