async def deposit_amount(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    
    amount = float(query.data.replace("deposit_", ""))
    user_id = query.from_user.id
    
    # Создаем инвойс
    invoice = await create_crypto_invoice(amount, f"Deposit for user {user_id}", user_id)
    
    if not invoice:
        await query.edit_message_text(
            "❌ Ошибка создания счета. Попробуйте позже.",
            reply_markup=InlineKeyboardMarkup([[
                InlineKeyboardButton("◀️ Назад", callback_data="deposit_menu")
            ]])
        )
        return
    
    invoice_id = invoice.get('invoice_id')
    pay_url = invoice.get('pay_url')
    
    # Сохраняем инвойс
    pending_invoices[invoice_id] = {
        'user_id': user_id,
        'type': 'deposit',
        'amount': amount,
        'date': datetime.now().isoformat()
    }
    
    text = (
        f"💰 **ПОПОЛНЕНИЕ БАЛАНСА**\n\n"
        f"Сумма: {amount} USDT\n\n"
        f"Для пополнения нажмите кнопку ниже и отправьте {amount} USDT"
    )
    
    keyboard = [
        [InlineKeyboardButton("💳 ОПЛАТИТЬ", url=pay_url)],
        [InlineKeyboardButton("✅ Я ОПЛАТИЛ", callback_data=f"check_deposit_{invoice_id}")],
        [InlineKeyboardButton("❌ Отмена", callback_data="deposit_menu")]
    ]
    reply_markup = InlineKeyboardMarkup(keyboard)
    
    await query.edit_message_text(text, reply_markup=reply_markup, parse_mode='Markdown')

async def check_deposit(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    
    invoice_id = query.data.replace("check_deposit_", "")
    
    if invoice_id not in pending_invoices:
        await query.answer("❌ Счет не найден или устарел", show_alert=True)
        return
    
    invoice_data = pending_invoices[invoice_id]
    user_id = query.from_user.id
    
    if invoice_data['user_id'] != user_id:
        await query.answer("❌ Это не ваш счет", show_alert=True)
        return
    
    # Проверяем оплату
    paid = await check_crypto_payment(invoice_id)
    
    if not paid:
        await query.answer("❌ Оплата не найдена", show_alert=True)
        return
    
    # Начисляем баланс
    amount = invoice_data['amount']
    user_balances[user_id] = user_balances.get(user_id, 0) + amount
    
    transactions.append({
        'user_id': user_id,
        'type': 'deposit',
        'amount': amount,
        'date': datetime.now().isoformat()
    })
    
    # Удаляем инвойс
    del pending_invoices[invoice_id]
    
    await query.edit_message_text(
        f"✅ Баланс успешно пополнен!\n\n"
        f"Сумма: {amount}$\n"
        f"Текущий баланс: {user_balances[user_id]}$",
        reply_markup=InlineKeyboardMarkup([[
            InlineKeyboardButton("👤 В профиль", callback_data="profile_menu")
        ]])
    )

async def activate_promo(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
