async def create_crypto_invoice(amount, description, user_id):
    if not CP_TOKEN:
        return None
    
    headers = {
        "Crypto-Pay-API-Token": CP_TOKEN,
        "Content-Type": "application/json"
    }
    
    payload = {
        "asset": "USDT",
        "amount": str(amount),
        "description": description
    }
    
    try:
        async with aiohttp.ClientSession() as session:
            async with session.post(
                "https://pay.crypt.bot/api/createInvoice",
                headers=headers,
                json=payload,
                timeout=30
            ) as resp:
                if resp.status == 200:
                    data = await resp.json()
                    if data.get("ok"):
                        return data["result"]
    except:
        pass
    return None

async def check_crypto_payment(invoice_id, user_id):
    if not CP_TOKEN:
        return False
    
    headers = {"Crypto-Pay-API-Token": CP_TOKEN}
    params = {"invoice_ids": invoice_id}
    
    try:
        async with aiohttp.ClientSession() as session:
            async with session.get(
                "https://pay.crypt.bot/api/getInvoices",
                headers=headers,
                params=params,
                timeout=30
            ) as resp:
                if resp.status == 200:
                    data = await resp.json()
                    if data.get("ok") and data.get("result", {}).get("items"):
                        invoice = data["result"]["items"][0]
                        if str(user_id) in invoice.get("description", ""):
                            return invoice.get("status") == "paid"
    except:
        pass
    return False

