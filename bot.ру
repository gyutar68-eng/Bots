    query = update.callback_query
    await query.answer()
    
    user_id = query.from_user.id
    user_cart = carts.get(user_id, [])
    
    if not user_cart:
        await query.edit_message_text(
            "❌ Корзина пуста",
            reply_markup=InlineKeyboardMarkup([[
                InlineKeyboardButton("📦 В каталог", callback_data="catalog")
            ]])
        )
        return
    
    total_rub = sum(item['price'] for item in user_cart)
    
    if not CP_TOKEN:
        await query.edit_message_text(
            f"❌ Оплата временно недоступна",
            reply_markup=InlineKeyboardMarkup([[
                InlineKeyboardButton("◀️ Назад", callback_data="cart")
            ]])
        )
        return
    
    # Конвертируем рубли в USDT
