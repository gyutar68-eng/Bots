        result_text += f"🔑 **Активация:** {case['activation']}\n"
        result_text += f"📦 **Выдача:** {case['delivery']}\n\n"
        result_text += "Напишите администратору @YungTrezinny для получения."
        
        admin_msg = (
            f"🎮 ВЫИГРЫШ ИГРЫ В КЕЙСЕ\n\n"
