cached_rate = None
last_rate_update = 0

async def get_usdt_rate():
    global cached_rate, last_rate_update
    if cached_rate and (datetime.now().timestamp() - last_rate_update) < 3600:
        return cached_rate
    try:
        url = "https://api.coingecko.com/api/v3/simple/price?ids=tether&vs_currencies=rub"
        async with aiohttp.ClientSession() as session:
            async with session.get(url, timeout=10) as resp:
                if resp.status == 200:
                    data = await resp.json()
                    rate = data.get("tether", {}).get("rub")
                    if rate:
                        cached_rate = rate
                        last_rate_update = datetime.now().timestamp()
                        return rate
    except:
        pass
    return DEFAULT_USDT_RATE

async def create_crypto_invoice(amount, description, user_id):
    if not CP_TOKEN:
        return None
    
    headers = {
        "Crypto-Pay-API-Token": CP_TOKEN,
        "Content-Type": "application/json"
    }
    
    full_description = f"{description} | User: {user_id}"
    
    payload = {
        "asset": "USDT",
        "amount": str(amount),
        "description": full_description,
        "expires_in": 3600
    }
    
    try:
        async with aiohttp.ClientSession() as session:
            async with session.post(
                "https://pay.crypt.bot/api/createInvoice",
                headers=headers,
                json=payload,
                timeout=30
            ) as resp:
                if resp.status == 200:
                    data = await resp.json()
                    if data.get("ok"):
                        return data["result"]
    except:
        pass
    return None

async def check_crypto_payment(invoice_id):
    if not CP_TOKEN:
        return False
    
    headers = {"Crypto-Pay-API-Token": CP_TOKEN}
    params = {"invoice_ids": invoice_id}
    
    try:
        async with aiohttp.ClientSession() as session:
            async with session.get(
                "https://pay.crypt.bot/api/getInvoices",
                headers=headers,
                params=params,
                timeout=30
            ) as resp:
                if resp.status == 200:
                    data = await resp.json()
                    if data.get("ok") and data.get("result", {}).get("items"):
                        invoice = data["result"]["items"][0]
                        return invoice.get("status") == "paid"
    except:
        pass
    return False

