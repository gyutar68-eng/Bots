async def check_deposit(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    
    invoice_id = query.data.replace("check_deposit_", "")
    
    if 'pending_invoices' not in context.bot_data or invoice_id not in context.bot_data['pending_invoices']:
        await query.answer("❌ Счет не найден", show_alert=True)
        return
    
    invoice_data = context.bot_data['pending_invoices'][invoice_id]
    
    if invoice_data['user_id'] != query.from_user.id:
        await query.answer("❌ Это не ваш счет", show_alert=True)
        return
    
    paid = await check_crypto_payment(invoice_id)
    
    if not paid:
        await query.answer("❌ Оплата не найдена", show_alert=True)
        return
    
    amount = invoice_data['amount']
    context.user_data['balance'] = context.user_data.get('balance', 0) + amount
    
    del context.bot_data['pending_invoices'][invoice_id]
    
    await query.edit_message_text(
        f"✅ **БАЛАНС ПОПОЛНЕН!**\n\n"
        f"💰 Сумма: {amount}$\n"
        f"💵 Текущий баланс: {context.user_data['balance']}$",
        reply_markup=InlineKeyboardMarkup([[
            InlineKeyboardButton("👤 В профиль", callback_data="profile_menu")
