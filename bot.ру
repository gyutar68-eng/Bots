async def open_case_after_payment(update: Update, context: ContextTypes.DEFAULT_TYPE, case_id, user_id):
    query = update.callback_query
    case = CASES.get(case_id)
    
    if not case:
        return
    
    # Инициализируем статистику
    if user_id not in user_stats:
