async def process_promo(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    promo_name = update.message.text.strip().upper()
    
    if promo_name not in promo_codes:
        await update.message.reply_text(
            "❌ Промокод не найден!",
            reply_markup=InlineKeyboardMarkup([[
                InlineKeyboardButton("◀️ Назад", callback_data="profile_menu")
            ]])
        )
        return ConversationHandler.END
    
    promo = promo_codes[promo_name]
    
    if promo['uses_left'] <= 0:
        await update.message.reply_text(
            "❌ Промокод уже использован максимальное количество раз!",
            reply_markup=InlineKeyboardMarkup([[
                InlineKeyboardButton("◀️ Назад", callback_data="profile_menu")
            ]])
        )
        return ConversationHandler.END
    
    if 'activated_by' not in promo:
        promo['activated_by'] = []
    
    if user_id in promo['activated_by']:
        await update.message.reply_text(
            "❌ Вы уже активировали этот промокод!",
            reply_markup=InlineKeyboardMarkup([[
                InlineKeyboardButton("◀️ Назад", callback_data="profile_menu")
            ]])
        )
        return ConversationHandler.END
    
    if user_id not in user_balances:
        user_balances[user_id] = 0
