    await query.answer()
    
    text = "💰 **БАЛАНС**\n\nВыбери действие:"
    
    keyboard = [
        [InlineKeyboardButton("➕ Добавить", callback_data="admin_balance_add")],
        [InlineKeyboardButton("◀️ Назад", callback_data="admin_panel")]
    ]
    
    await query.edit_message_text(text, reply_markup=InlineKeyboardMarkup(keyboard), parse_mode='Markdown')

async def admin_balance_add(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    
    await query.edit_message_text(
        "💰 **ДОБАВИТЬ БАЛАНС**\n\n"
        "Введи: ID сумма\n"
        "Пример: `123456789 10`",
        parse_mode='Markdown',
        reply_markup=InlineKeyboardMarkup([[
            InlineKeyboardButton("❌ Отмена", callback_data="admin_balance")
        ]])
    )
    
    return WAITING_FOR_ADMIN_USER_ID

async def admin_balance_add_process(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if update.effective_user.id != ADMIN_ID:
        return ConversationHandler.END
    
    text = update.message.text.strip()
    parts = text.split()
    
    if len(parts) != 2:
        await update.message.reply_text(
            "❌ Неверный формат",
            reply_markup=InlineKeyboardMarkup([[
                InlineKeyboardButton("◀️ Назад", callback_data="admin_balance")
            ]])
        )
        return WAITING_FOR_ADMIN_USER_ID
    
    try:
        target_id = int(parts[0])
        amount = float(parts[1])
        
        if amount <= 0:
            await update.message.reply_text("❌ Сумма должна быть > 0")
            return WAITING_FOR_ADMIN_USER_ID
        
        await update.message.reply_text(
            f"✅ Баланс {target_id} +{amount}$\n"
            f"(Пользователь должен быть онлайн)",
            reply_markup=InlineKeyboardMarkup([[
                InlineKeyboardButton("◀️ В админку", callback_data="admin_panel")
            ]])
        )
        
    except:
        await update.message.reply_text("❌ Ошибка")
        return WAITING_FOR_ADMIN_USER_ID
    
    return ConversationHandler.END

async def admin_stats(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
