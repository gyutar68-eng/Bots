async def check_deposit_callback(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    
    invoice_id = int(query.data.split("_")[2])
    user_id = query.from_user.id
    
    deposit_info = None
    if "pending_deposits" in context.user_data:
        for d in context.user_data["pending_deposits"]:
            if d["invoice_id"] == invoice_id and d["user_id"] == user_id:
                deposit_info = d
                break
    
    if not deposit_info:
        await query.answer("❌ Платёж не найден", show_alert=True)
        return
    
    is_paid = await check_crypto_payment(invoice_id, user_id)
    
    if is_paid:
        if user_id not in user_balances:
            user_balances[user_id] = 0
        user_balances[user_id] += deposit_info['amount']
        
        transactions.append({
            'user_id': user_id,
            'type': 'deposit',
            'amount': deposit_info['amount'],
            'date': datetime.now().isoformat()
        })
        
        if user_id not in user_stats:
            user_stats[user_id] = {'spent': 0, 'opened_cases': 0, 'won': 0, 'nickname': '', 'join_date': datetime.now().isoformat()}
        
        await query.edit_message_text(
            f"✅ Баланс успешно пополнен!\n\n"
            f"Зачислено: {deposit_info['amount']}$\n"
