import os
import logging
import json
from telegram import Update, InlineKeyboardButton, InlineKeyboardMarkup
from telegram.ext import Application, CommandHandler, CallbackQueryHandler, ContextTypes

# Настройка логирования
logging.basicConfig(
    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s',
    level=logging.INFO
)
logger = logging.getLogger(__name__)

# Токен и канал из переменных окружения
TOKEN = os.getenv("BOT_TOKEN")
CHANNEL_ID = os.getenv("CHANNEL_ID")
CHANNEL_URL = os.getenv("CHANNEL_URL", f"https://t.me/{CHANNEL_ID.replace('@', '')}")

if not TOKEN:
    raise ValueError("❌ НЕТ BOT_TOKEN В ОКРУЖЕНИИ!")

# ============================================
# ДАННЫЕ ТОВАРОВ
# ============================================
PRODUCTS = {
    "logs": {
        "name": "📦 Логи",
        "stock": 2250,  # Наличие
        "prices": {
            1: 1500,
            3: 4500,
            5: 7500,
            10: 15000
        }
    }
}

# Временное хранилище корзин (в реальном проекте используй БД)
carts = {}

# ============================================
# ФУНКЦИЯ ПРОВЕРКИ ПОДПИСКИ
# ============================================
async def check_subscription(user_id, context):
    """Проверяет, подписан ли пользователь на канал"""
    try:
        member = await context.bot.get_chat_member(chat_id=CHANNEL_ID, user_id=user_id)
        return member.status in ["member", "creator", "administrator"]
    except Exception as e:
        logger.error(f"Ошибка проверки подписки для {user_id}: {e}")
        return False

# ============================================
# КОМАНДА /start
# ============================================
async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Обработчик команды /start"""
    user = update.effective_user
    user_id = user.id
    
    logger.info(f"Пользователь {user_id} запустил бота")
    
    # Проверяем подписку
    is_subscribed = await check_subscription(user_id, context)
    
    if is_subscribed:
        # Если подписан - показываем главное меню
        await show_main_menu(update, context)
    else:
        # Если не подписан - просим подписаться
        await send_subscribe_request(update, context)

# ============================================
# ПОКАЗ ГЛАВНОГО МЕНЮ
# ============================================
async def show_main_menu(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Отображает главное меню"""
    keyboard = [
        [InlineKeyboardButton("🛍 Каталог товаров", callback_data="catalog")],
        [InlineKeyboardButton("🛒 Моя корзина", callback_data="cart")],
        [InlineKeyboardButton("ℹ️ О нас", callback_data="about")]
    ]
    reply_markup = InlineKeyboardMarkup(keyboard)
    
    text = f"👋 Привет, {update.effective_user.first_name}!\n\nВыберите действие:"
    
    if update.callback_query:
        await update.callback_query.edit_message_text(text, reply_markup=reply_markup)
    else:
        await update.message.reply_text(text, reply_markup=reply_markup)

# ============================================
# ЗАПРОС ПОДПИСКИ
# ============================================
async def send_subscribe_request(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Отправляет сообщение с просьбой подписаться"""
    keyboard = [
        [InlineKeyboardButton("🔗 ПОДПИСАТЬСЯ", url=CHANNEL_URL)],
        [InlineKeyboardButton("✅ Я ПОДПИСАЛСЯ", callback_data="check_sub")]
    ]
    reply_markup = InlineKeyboardMarkup(keyboard)
    
    text = f"👋 Привет, {update.effective_user.first_name}!\n\n❌ Для доступа к боту нужно подписаться на канал:\n📢 {CHANNEL_ID}"
    
    if update.callback_query:
        await update.callback_query.edit_message_text(text, reply_markup=reply_markup)
    else:
        await update.message.reply_text(text, reply_markup=reply_markup)

# ============================================
# ПРОВЕРКА ПОДПИСКИ ПОСЛЕ НАЖАТИЯ КНОПКИ
# ============================================
async def check_subscription_callback(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Обработчик нажатия на кнопку 'Я ПОДПИСАЛСЯ'"""
    query = update.callback_query
    await query.answer()
    
    user_id = query.from_user.id
    is_subscribed = await check_subscription(user_id, context)
    
    if is_subscribed:
        await show_main_menu(update, context)
    else:
        await query.edit_message_text(
            f"❌ Подписка не найдена!",
            reply_markup=InlineKeyboardMarkup([[
                InlineKeyboardButton("🔗 ПОДПИСАТЬСЯ", url=CHANNEL_URL)
            ]])
        )

# ============================================
# КАТАЛОГ ТОВАРОВ
# ============================================
async def catalog(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Показывает каталог категорий"""
    query = update.callback_query
    await query.answer()
    
    keyboard = [
        [InlineKeyboardButton(f"📦 Логи (в наличии: {PRODUCTS['logs']['stock']} шт)", callback_data="category_logs")],
        [InlineKeyboardButton("◀️ Назад", callback_data="back_to_menu")]
    ]
    reply_markup = InlineKeyboardMarkup(keyboard)
    
    await query.edit_message_text(
        "🛍 Каталог товаров\n\nВыберите категорию:",
        reply_markup=reply_markup
    )

# ============================================
# КАТЕГОРИЯ "ЛОГИ"
# ============================================
async def category_logs(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Показывает товары в категории Логи"""
    query = update.callback_query
    await query.answer()
    
    product = PRODUCTS["logs"]
    
    keyboard = [
        [InlineKeyboardButton("1 шт - 1500 ₽", callback_data="buy_logs_1")],
        [InlineKeyboardButton("3 шт - 4500 ₽", callback_data="buy_logs_3")],
        [InlineKeyboardButton("5 шт - 7500 ₽", callback_data="buy_logs_5")],
        [InlineKeyboardButton("10 шт - 15000 ₽", callback_data="buy_logs_10")],
        [InlineKeyboardButton("◀️ Назад к каталогу", callback_data="catalog")]
    ]
    reply_markup = InlineKeyboardMarkup(keyboard)
    
    await query.edit_message_text(
        f"📦 Логи\n\n"
        f"В наличии: {product['stock']} шт\n\n"
        f"Цены:\n"
        f"• 1 шт = 1500 ₽\n"
        f"• 3 шт = 4500 ₽\n"
        f"• 5 шт = 7500 ₽\n"
        f"• 10 шт = 15000 ₽\n\n"
        f"Выберите количество:",
        reply_markup=reply_markup
    )

# ============================================
# ПОКУПКА ТОВАРА
# ============================================
async def buy_logs(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Обработчик покупки логов"""
    query = update.callback_query
    await query.answer()
    
    # Получаем количество из callback_data (например "buy_logs_1" -> 1)
    quantity = int(query.data.split("_")[2])
    product = PRODUCTS["logs"]
    price = product["prices"][quantity]
    
    # Проверяем наличие
    if product["stock"] < quantity:
        await query.edit_message_text(
            f"❌ Недостаточно товара в наличии!\n"
            f"Доступно: {product['stock']} шт",
            reply_markup=InlineKeyboardMarkup([[
                InlineKeyboardButton("◀️ Назад", callback_data="category_logs")
            ]])
        )
        return
    
    # Добавляем в корзину (здесь временно, в реальном проекте - БД)
    user_id = query.from_user.id
    if user_id not in carts:
        carts[user_id] = []
    
    # Проверяем, не покупал ли уже такое же
    cart_item = {
        "category": "logs",
        "quantity": quantity,
        "price": price,
        "total": price
    }
    carts[user_id].append(cart_item)
    
    # Уменьшаем наличие (в реальном проекте - только после оплаты)
    product["stock"] -= quantity
    
    keyboard = [
        [InlineKeyboardButton("🛒 Перейти в корзину", callback_data="cart")],
        [InlineKeyboardButton("📦 Продолжить покупки", callback_data="category_logs")]
    ]
    reply_markup = InlineKeyboardMarkup(keyboard)
    
    await query.edit_message_text(
        f"✅ Товар добавлен в корзину!\n\n"
        f"📦 Логи {quantity} шт\n"
        f"💰 Сумма: {price} ₽\n\n"
        f"Осталось в наличии: {product['stock']} шт",
        reply_markup=reply_markup
    )

# ============================================
# КОРЗИНА
# ============================================
async def cart(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Показывает содержимое корзины"""
    query = update.callback_query
    await query.answer()
    
    user_id = query.from_user.id
    user_cart = carts.get(user_id, [])
    
    if not user_cart:
        keyboard = [[InlineKeyboardButton("📦 В каталог", callback_data="catalog")]]
        await query.edit_message_text(
            "🛒 Ваша корзина пуста",
            reply_markup=InlineKeyboardMarkup(keyboard)
        )
        return
    
    total = 0
    cart_text = "🛒 ВАША КОРЗИНА:\n\n"
    
    for i, item in enumerate(user_cart, 1):
        cart_text += f"{i}. 📦 Логи {item['quantity']} шт - {item['price']} ₽\n"
        total += item['price']
    
    cart_text += f"\n💰 ИТОГО: {total} ₽"
    
    keyboard = [
        [InlineKeyboardButton("✅ Оформить заказ", callback_data="checkout")],
        [InlineKeyboardButton("📦 Продолжить покупки", callback_data="catalog")]
    ]
    reply_markup = InlineKeyboardMarkup(keyboard)
    
    await query.edit_message_text(cart_text, reply_markup=reply_markup)

# ============================================
# ОФОРМЛЕНИЕ ЗАКАЗА
# ============================================
async def checkout(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Оформление заказа"""
    query = update.callback_query
    await query.answer()
    
    user_id = query.from_user.id
    user_cart = carts.get(user_id, [])
    
    if not user_cart:
        await query.edit_message_text("❌ Корзина пуста")
        return
    
    total = sum(item['price'] for item in user_cart)
    
    # Здесь будет оплата (крипта или другой способ)
    keyboard = [
        [InlineKeyboardButton("💳 Оплатить", callback_data="pay")],
        [InlineKeyboardButton("◀️ Назад в корзину", callback_data="cart")]
    ]
    reply_markup = InlineKeyboardMarkup(keyboard)
    
    await query.edit_message_text(
        f"✅ ЗАКАЗ ГОТОВ К ОПЛАТЕ\n\n"
        f"Сумма: {total} ₽\n"
        f"Товары: {len(user_cart)} позиций\n\n"
        f"Выберите способ оплаты:",
        reply_markup=reply_markup
    )

# ============================================
# ОПЛАТА (ЗАГЛУШКА)
# ============================================
async def pay(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Заглушка для оплаты"""
    query = update.callback_query
    await query.answer()
    
    user_id = query.from_user.id
    user_cart = carts.get(user_id, [])
    
    if not user_cart:
        await query.edit_message_text("❌ Корзина пуста")
        return
    
    # Очищаем корзину после "оплаты"
    carts[user_id] = []
    
    await query.edit_message_text(
        "✅ Оплата прошла успешно!\n"
        "Товар будет отправлен в ближайшее время.\n\n"
        "Спасибо за покупку!",
        reply_markup=InlineKeyboardMarkup([[
            InlineKeyboardButton("📦 В каталог", callback_data="catalog")
        ]])
    )

# ============================================
# О НАС
# ============================================
async def about(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Информация о магазине"""
    query = update.callback_query
    await query.answer()
    
    keyboard = [[InlineKeyboardButton("◀️ Назад", callback_data="back_to_menu")]]
    reply_markup = InlineKeyboardMarkup(keyboard)
    
    await query.edit_message_text(
        "ℹ️ О НАС\n\n"
        "Лучший магазин логов в Telegram\n"
        "Работаем 24/7\n"
        "Быстрая доставка\n"
        f"📦 В наличии: {PRODUCTS['logs']['stock']} шт",
        reply_markup=reply_markup
    )

# ============================================
# MAIN
# ============================================
def main():
    """Запуск бота"""
    app = Application.builder().token(TOKEN).build()
    
    # Команда /start
    app.add_handler(CommandHandler("start", start))
    
    # Обработчики callback-запросов
    app.add_handler(CallbackQueryHandler(check_subscription_callback, pattern="check_sub"))
    app.add_handler(CallbackQueryHandler(back_to_menu, pattern="back_to_menu"))
    
    # Обработчики меню
    app.add_handler(CallbackQueryHandler(catalog, pattern="catalog"))
    app.add_handler(CallbackQueryHandler(category_logs, pattern="category_logs"))
    app.add_handler(CallbackQueryHandler(cart, pattern="cart"))
    app.add_handler(CallbackQueryHandler(about, pattern="about"))
    app.add_handler(CallbackQueryHandler(checkout, pattern="checkout"))
    app.add_handler(CallbackQueryHandler(pay, pattern="pay"))
    
    # Обработчики покупок (все, что начинаются с buy_logs_)
    app.add_handler(CallbackQueryHandler(buy_logs, pattern="^buy_logs_[0-9]+$"))
    
    logger.info("🚀 Бот запущен...")
    app.run_polling()

async def back_to_menu(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Возврат в главное меню"""
    await show_main_menu(update, context)

if __name__ == "__main__":
    main()
