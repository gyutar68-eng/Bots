# ============================================
# ФУНКЦИЯ ПРОВЕРКИ ПОДПИСКИ
# ============================================
async def check_subscription(user_id, context):
    """Проверяет, подписан ли пользователь на канал"""
    try:
        member = await context.bot.get_chat_member(chat_id=CHANNEL_ID, user_id=user_id)
        return member.status in ["member", "creator", "administrator"]
    except Exception as e:
        logger.error(f"Ошибка проверки подписки для {user_id}: {e}")
        return False

# ============================================
# ПОЛУЧЕНИЕ ПРОГРЕССА ПОЛЬЗОВАТЕЛЯ
# ============================================
def get_user_progress(user_id):
    """Получает или создает прогресс пользователя по FAQ"""
    # В реальном проекте используй БД. Здесь для примера - context.user_data
    # Но так как у нас нет доступа к context в этой функции, будем хранить в глобальном словаре
    if not hasattr(get_user_progress, "progress"):
        get_user_progress.progress = {}
    
    if user_id not in get_user_progress.progress:
        # Создаем прогресс для нового пользователя
        progress = {str(section["id"]): False for section in FAQ_SECTIONS}
        get_user_progress.progress[user_id] = progress
    
    return get_user_progress.progress[user_id]

def save_user_progress(user_id, progress):
    """Сохраняет прогресс пользователя"""
    if not hasattr(get_user_progress, "progress"):
        get_user_progress.progress = {}
    get_user_progress.progress[user_id] = progress

# ============================================
# КОМАНДА /start
# ============================================
async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Обработчик команды /start"""
    user = update.effective_user
    user_id = user.id
    first_name = user.first_name
    
    logger.info(f"Пользователь {user_id} ({first_name}) запустил бота")
    
    # Проверяем подписку
    is_subscribed = await check_subscription(user_id, context)
    
    if is_subscribed:
        # Если подписан - показываем FAQ
        await show_faq(update, context)
    else:
        # Если не подписан - просим подписаться
        await send_subscribe_request(update, context)

# ============================================
# ЗАПРОС ПОДПИСКИ (ДЛЯ НЕПОДПИСАННЫХ)
# ============================================
async def send_subscribe_request(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Отправляет сообщение с просьбой подписаться"""
    keyboard = [
        [InlineKeyboardButton("🔗 ПОДПИСАТЬСЯ", url=CHANNEL_URL)],
        [InlineKeyboardButton("✅ Я ПОДПИСАЛСЯ", callback_data="check_sub")]
    ]
    reply_markup = InlineKeyboardMarkup(keyboard)
    
    text = (
        f"👋 Привет, {update.effective_user.first_name}!\n\n"
        f"❌ Для доступа к боту нужно подписаться на канал:\n"
        f"📢 {CHANNEL_ID}\n\n"
        f"После подписки нажми кнопку «Я ПОДПИСАЛСЯ»"
    )
    
    if update.callback_query:
        await update.callback_query.edit_message_text(text, reply_markup=reply_markup)
    else:
        await update.message.reply_text(text, reply_markup=reply_markup)

# ============================================
# ПРОВЕРКА ПОДПИСКИ ПОСЛЕ НАЖАТИЯ КНОПКИ
# ============================================
async def check_subscription_callback(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Обработчик нажатия на кнопку 'Я ПОДПИСАЛСЯ'"""
    query = update.callback_query
    await query.answer()
    
    user_id = query.from_user.id
    
    # Проверяем подписку
    is_subscribed = await check_subscription(user_id, context)
    
    if is_subscribed:
        # Если подписан - показываем FAQ
        await show_faq(update, context)
    else:
        await query.edit_message_text(
            f"❌ Подписка не найдена!\n\n"
            f"Убедитесь, что вы подписались на канал {CHANNEL_ID}\n"
            f"и нажмите кнопку еще раз.",
            reply_markup=InlineKeyboardMarkup([[
                InlineKeyboardButton("🔗 ПОДПИСАТЬСЯ", url=CHANNEL_URL)
            ]])
        )

# ============================================
# ПОКАЗ FAQ
# ============================================
async def show_faq(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Отображает меню FAQ"""
    user_id = update.effective_user.id
    
    # Получаем прогресс пользователя
    if "faq_progress" not in context.user_data:
        # Создаем прогресс для нового пользователя
        context.user_data["faq_progress"] = {str(section["id"]): False for section in FAQ_SECTIONS}
    
    progress = context.user_data["faq_progress"]
    
    # Считаем прочитанные разделы
    read_count = sum(1 for v in progress.values() if v)
    total = len(FAQ_SECTIONS)
    
    # Создаем кнопки для каждого раздела
    keyboard = []
    for section in FAQ_SECTIONS:
        section_id = str(section["id"])
        is_read = progress.get(section_id, False)
        emoji = "✅" if is_read else "🔗"
        button_text = f"{emoji} {section['name']}"
        keyboard.append([InlineKeyboardButton(button_text, callback_data=f"faq_{section_id}")])
    
    # Кнопка для перехода к магазину (если всё прочитано)
    if read_count == total:
        keyboard.append([InlineKeyboardButton("✅ ВСЁ ПРОЧИТАНО! Перейти в магазин", callback_data="go_to_shop")])
    else:
        keyboard.append([InlineKeyboardButton(f"✖️ Прочитайте все разделы ({read_count}/{total})", callback_data="faq_reminder")])
    
    reply_markup = InlineKeyboardMarkup(keyboard)
    
    text = (
        f"📋 FAQ - Обязательное ознакомление\n\n"
        f"Перед использованием бота необходимо ознакомиться со всеми разделами FAQ.\n\n"
        f"✔️ Прочитано: {read_count}/{total} разделов\n\n"
        f"Выберите раздел для изучения:"
    )
    
    if update.callback_query:
        await update.callback_query.edit_message_text(text, reply_markup=reply_markup)
    else:
        await update.message.reply_text(text, reply_markup=reply_markup)

# ============================================
# ОБРАБОТЧИК РАЗДЕЛОВ FAQ
# ============================================
async def faq_section_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Показывает содержимое раздела FAQ"""
    query = update.callback_query
    await query.answer()
    
    section_id = query.data.replace("faq_", "")
    user_id = update.effective_user.id
    
    # Находим раздел
    section = next((s for s in FAQ_SECTIONS if str(s["id"]) == section_id), None)
    if not section:
        return
    
    # Отмечаем раздел как прочитанный
    if "faq_progress" not in context.user_data:
        context.user_data["faq_progress"] = {}
    
    context.user_data["faq_progress"][section_id] = True
    
    # Кнопка возврата
    keyboard = [[InlineKeyboardButton("◀️ Назад к FAQ", callback_data="back_to_faq")]]
    reply_markup = InlineKeyboardMarkup(keyboard)
    
    await query.edit_message_text(
        section["content"],
        reply_markup=reply_markup
    )

# ============================================
# НАПОМИНАНИЕ О НЕПРОЧИТАННЫХ РАЗДЕЛАХ
# ============================================
async def faq_reminder_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Напоминает о непрочитанных разделах"""
    query = update.callback_query
    await query.answer()
    
    read_count = sum(1 for v in context.user_data.get("faq_progress", {}).values() if v)
    total = len(FAQ_SECTIONS)
    remaining = total - read_count
    
    await query.answer(
        f"❌ Осталось прочитать {remaining} разделов!",
        show_alert=True
    )

