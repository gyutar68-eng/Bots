async def process_unban(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Обработка разбана"""
    query = update.callback_query
    user_id = query.from_user.id
    
    if user_id != ADMIN_ID:
        await query.answer("⛔ Доступ запрещён!", show_alert=True)
        return
    
    target_id = int(query.data.replace("unban_", ""))
    
    if target_id in banned_users:
        banned_users.remove(target_id)
        
        # Уведомляем пользователя
        try:
            await context.bot.send_message(
                chat_id=target_id,
                text="✅ Вы были разбанены!"
            )
        except:
            pass
        
        await query.answer(f"✅ Пользователь {target_id} разбанен", show_alert=True)
    else:
        await query.answer("❌ Пользователь не в бане", show_alert=True)
    
    # Обновляем список
    await admin_unban(update, context)

