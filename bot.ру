                InlineKeyboardButton("👤 В профиль", callback_data="profile_menu")
            ]])
        )
        
        context.user_data["pending_deposits"].remove(deposit_info)
    else:
        await query.answer("⏳ Платёж не найден или не оплачен", show_alert=True)

