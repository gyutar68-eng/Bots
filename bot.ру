async def create_crypto_invoice(amount, description, user_id):
    if not CP_TOKEN:
        return None
    
    headers = {
        "Crypto-Pay-API-Token": CP_TOKEN,
        "Content-Type": "application/json"
    }
    
    # Добавляем user_id в описание для идентификации
    full_description = f"{description} | User: {user_id}"
    
    payload = {
        "asset": "USDT",
        "amount": str(amount),
        "description": full_description,
        "expires_in": 3600  # Час на оплату
    }
    
    try:
        async with aiohttp.ClientSession() as session:
            async with session.post(
                "https://pay.crypt.bot/api/createInvoice",
                headers=headers,
                json=payload,
                timeout=30
            ) as resp:
                if resp.status == 200:
                    data = await resp.json()
                    if data.get("ok"):
                        return data["result"]
                    else:
                        logger.error(f"Crypto bot error: {data}")
                else:
                    logger.error(f"HTTP error: {resp.status}")
    except Exception as e:
        logger.error(f"Error creating invoice: {e}")
    return None

async def check_crypto_payment(invoice_id):
    if not CP_TOKEN:
        return False
    
    headers = {"Crypto-Pay-API-Token": CP_TOKEN}
    params = {"invoice_ids": invoice_id}
    
    try:
        async with aiohttp.ClientSession() as session:
            async with session.get(
                "https://pay.crypt.bot/api/getInvoices",
                headers=headers,
                params=params,
                timeout=30
            ) as resp:
                if resp.status == 200:
                    data = await resp.json()
                    if data.get("ok") and data.get("result", {}).get("items"):
                        invoice = data["result"]["items"][0]
                        return invoice.get("status") == "paid"
    except Exception as e:
        logger.error(f"Error checking payment: {e}")
    return False

