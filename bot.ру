async def handle_captcha_answer(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    answer = update.message.text.strip()
    
    if user_id not in clicker_data or not context.user_data.get('awaiting_captcha', False):
        return
    
    user_data = clicker_data[user_id]
    captcha = user_data.get('captcha', {})
    
    if answer == captcha.get('answer', ''):
        # Правильный ответ
        user_data['verification_pending'] = False
        clicker_data[user_id] = user_data
        context.user_data['awaiting_captcha'] = False
        
        await update.message.reply_text("✅ Проверка пройдена! Продолжайте кликать.")
        
        # Возвращаем в меню кликера
        # Создаем фиктивный callback_query
        class FakeQuery:
            def __init__(self, user_id):
                self.from_user = type('obj', (object,), {'id': user_id})
                self.message = update.message
            
            async def answer(self):
                pass
        
        fake_query = FakeQuery(user_id)
        await clicker_menu(Update(update.update_id, callback_query=fake_query), context)
    else:
        # Неправильный ответ
        await update.message.reply_text(
            f"❌ Неправильный ответ. Попробуйте снова.\n\n"
            f"Вопрос: {captcha.get('question', '')}\n"
            f"Напишите правильный ответ:"
        )

