async def clicker_click(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    
    if 'clicker' not in context.user_data:
        context.user_data['clicker'] = {
            'clicks': 0,
            'last_reset': datetime.now(timezone.utc).isoformat(),
            'checkpoint': 0,
            'verification_pending': False,
            'last_reward': None
        }
    
    user_data = context.user_data['clicker']
    
    if user_data.get('last_reward') and (datetime.now() - datetime.fromisoformat(user_data['last_reward'])).days < 7:
        await query.answer("⏳ Кулдаун 7 дней!", show_alert=True)
        return
    
    if user_data['clicks'] >= CLICKS_REQUIRED:
        await clicker_menu(update, context)
        return
    
    user_data['clicks'] += 1
    clicks = user_data['clicks']
    
    if clicks >= CLICKS_REQUIRED:
        await clicker_menu(update, context)
        return
    
    if clicks % CHECKPOINT_INTERVAL == 0 and clicks > 0:
        user_data['verification_pending'] = True
        
        num1 = random.randint(1, 10)
        num2 = random.randint(1, 10)
        captcha_answer = str(num1 + num2)
        
        context.user_data['captcha'] = {
            'question': f"{num1} + {num2} = ?",
            'answer': captcha_answer
        }
        
        await query.edit_message_text(
            f"🔐 **ПРОВЕРКА**\n\n"
            f"Кликов: {clicks}\n"
            f"Вопрос: {num1} + {num2} = ?\n\n"
            f"✏️ Напиши ответ:",
            reply_markup=InlineKeyboardMarkup([[
                InlineKeyboardButton("◀️ Отмена", callback_data="clicker_menu")
            ]])
        )
        
        return WAITING_FOR_CAPTCHA
    
    await clicker_menu(update, context)
    return ConversationHandler.END

