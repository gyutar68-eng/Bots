async def open_inventory_case(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    
    case_id = query.data.replace("open_inventory_", "")
    case = CASES.get(case_id)
    
    if not case:
        await query.answer("❌ Кейс не найден", show_alert=True)
        return
    
    if 'inventory' not in context.user_data or not context.user_data['inventory']:
        await query.answer("❌ Нет кейсов", show_alert=True)
        return
    
    # Находим первый кейс этого типа
    case_index = -1
    for i, c in enumerate(context.user_data['inventory']):
        if c['case_id'] == case_id:
            case_index = i
            break
    
    if case_index == -1:
        await query.answer("❌ Кейс не найден", show_alert=True)
        return
    
    # Удаляем кейс из инвентаря
    case_item = context.user_data['inventory'].pop(case_index)
    
    # Анимация
    frames = [
        "🎲 Открываем... ░░░░░░░░░░",
        "⚙️ Открываем... █░░░░░░░░░",
        "🔄 Открываем... ██░░░░░░░░",
        "🎰 Открываем... ███░░░░░░░",
        "💫 Открываем... ████░░░░░░",
        "✨ Открываем... █████░░░░░",
        "🌟 Открываем... ██████░░░░",
        "💥 Открываем... ███████░░░",
    ]
    
    message = await query.edit_message_text(frames[0])
    
    for i in range(1, len(frames)):
        await asyncio.sleep(0.2)
        await message.edit_text(frames[i])
    
    await asyncio.sleep(0.1)
    await message.edit_text("🔮 Выбираем приз... ████████░░")
    await asyncio.sleep(0.2)
    await message.edit_text("💎 Почти готово... █████████░")
    await asyncio.sleep(0.2)
    
    # Выбор приза
    rand = random.random() * 100
    cumulative = 0
    win_item = None
    
    for item in case['real_items']:
        cumulative += item['chance']
        if rand <= cumulative:
            win_item = item
            break
    
    result_text = ""
    
    if win_item.get('type') == 'game':
        result_text = f"🎮 **Вы выиграли Terraria!**\n\nНапишите @YungTrezinny для получения."
        
        admin_msg = f"🎮 Выигрыш игры: {query.from_user.first_name} (ID: {query.from_user.id})"
        try:
            await context.bot.send_message(chat_id=ADMIN_ID, text=admin_msg)
        except:
            pass
    else:
        win_amount = win_item['amount']
        if 'balance' not in context.user_data:
            context.user_data['balance'] = 0
        context.user_data['balance'] += win_amount
        
        if 'stats' not in context.user_data:
            context.user_data['stats'] = {
                'spent': 0,
                'opened_cases': 0,
                'won': 0,
                'nickname': query.from_user.first_name,
                'join_date': datetime.now().isoformat()
            }
        
        context.user_data['stats']['won'] += win_amount
        context.user_data['stats']['opened_cases'] += 1
        
        if win_amount >= case['price'] * 1.5:
            result_text = f"🎉🎉🎉 **ДЖЕКПОТ!** 🎉🎉🎉\n\n💰 Выигрыш: {win_amount}$"
        elif win_amount > case['price']:
            result_text = f"🔥 **УДАЧА!** 🔥\n\n💰 Выигрыш: {win_amount}$"
        elif win_amount == case['price']:
            result_text = f"🤝 **Вернул своё** 🤝\n\n💰 Выигрыш: {win_amount}$"
        else:
            result_text = f"😢 **Не в этот раз...**\n\n💰 Выигрыш: {win_amount}$"
    
    keyboard = [
        [InlineKeyboardButton("📦 Ещё кейсы", callback_data="case_inventory")],
        [InlineKeyboardButton("👤 В профиль", callback_data="profile_menu")]
    ]
    
    final_text = f"{result_text}\n\n💰 **Твой баланс:** {context.user_data['balance']}$"
    
    await message.edit_text(final_text, reply_markup=InlineKeyboardMarkup(keyboard), parse_mode='Markdown')

