async def check_case_payment_callback(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    
    invoice_id = int(query.data.split("_")[3])
    user_id = query.from_user.id
    
    payment_info = None
    if "pending_case_payments" in context.user_data:
        for p in context.user_data["pending_case_payments"]:
            if p["invoice_id"] == invoice_id and p["user_id"] == user_id:
                payment_info = p
                break
    
    if not payment_info:
        await query.answer("❌ Платёж не найден", show_alert=True)
        return
    
    is_paid = await check_crypto_payment(invoice_id, user_id)
    
    if is_paid:
        # Удаляем информацию о платеже
        context.user_data["pending_case_payments"].remove(payment_info)
        
        # Открываем кейс
        await open_case_after_payment(update, context, payment_info['case_id'], user_id)
    else:
        await query.answer("⏳ Платёж не найден или не оплачен", show_alert=True)

