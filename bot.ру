# ============================================
# MAIN
# ============================================
def main():
    app = Application.builder().token(TOKEN).build()
    
    # Команда /start
    app.add_handler(CommandHandler("start", start))
    
    # Обработчики callback-запросов
    app.add_handler(CallbackQueryHandler(check_subscription_callback, pattern="check_sub"))
    app.add_handler(CallbackQueryHandler(back_to_faq, pattern="back_to_faq"))
    app.add_handler(CallbackQueryHandler(faq_reminder_handler, pattern="faq_reminder"))
    app.add_handler(CallbackQueryHandler(go_to_shop, pattern="go_to_shop"))
    app.add_handler(CallbackQueryHandler(back_to_menu, pattern="back_to_menu"))
    
    # Обработчики разделов FAQ
    app.add_handler(CallbackQueryHandler(faq_section_handler, pattern="^faq_[0-9]+$"))
    
    # Обработчики магазина
    app.add_handler(CallbackQueryHandler(catalog, pattern="catalog"))
    app.add_handler(CallbackQueryHandler(category_logs, pattern="category_logs"))
    app.add_handler(CallbackQueryHandler(cart, pattern="cart"))
    app.add_handler(CallbackQueryHandler(about, pattern="about"))
    app.add_handler(CallbackQueryHandler(checkout, pattern="checkout"))
    app.add_handler(CallbackQueryHandler(pay, pattern="pay"))
    app.add_handler(CallbackQueryHandler(buy_logs, pattern="^buy_logs_[0-9]+$"))
    
    logger.info("🚀 Бот запущен...")
    app.run_polling()

async def back_to_faq(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await show_faq(update, context)

async def back_to_menu(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await show_main_menu(update, context)

if __name__ == "__main__":
    main()
