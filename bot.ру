async def clicker_click(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    
    user_id = query.from_user.id
    
    # Проверяем сброс
    await reset_clicks_if_needed(user_id)
    
    user_data = clicker_data.get(user_id, {
        'clicks': 0,
        'last_reset': datetime.now(timezone.utc).isoformat(),
        'checkpoint': 0,
        'verification_pending': False
    })
    
    # Проверяем не висит ли проверка
    if user_data.get('verification_pending', False):
        await query.edit_message_text(
            "⚠️ Сначала пройдите проверку!",
            reply_markup=InlineKeyboardMarkup([[
                InlineKeyboardButton("✅ ПРОВЕРКА", callback_data="clicker_verify")
            ]])
        )
        return
    
    # Добавляем клик
    user_data['clicks'] = user_data.get('clicks', 0) + 1
    clicks = user_data['clicks']
    
    # Проверяем нужно ли показать капчу
    checkpoint = user_data.get('checkpoint', 0)
    if clicks // CHECKPOINT_INTERVAL > checkpoint:
        user_data['checkpoint'] = clicks // CHECKPOINT_INTERVAL
        user_data['verification_pending'] = True
        
        # Генерируем капчу
        captcha = await generate_captcha()
        user_data['captcha'] = captcha
        
        await query.edit_message_text(
            f"🔐 ПРОВЕРКА\n\n"
            f"Вы накликали {clicks} кликов. Докажите что вы не бот.\n\n"
            f"Вопрос: {captcha['question']}\n\n"
            f"Напишите ответ в чат:",
            reply_markup=InlineKeyboardMarkup([[
                InlineKeyboardButton("◀️ Отмена", callback_data="clicker_menu")
            ]])
        )
        
        # Переходим в режим ожидания ответа
        context.user_data['awaiting_captcha'] = True
        clicker_data[user_id] = user_data
        return
    
    clicker_data[user_id] = user_data
    
    # Возвращаемся в меню кликера
    await clicker_menu(update, context)

