async def checkout(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    
    user_id = query.from_user.id
    user_cart = carts.get(user_id, [])
    
    if not user_cart:
        await query.edit_message_text(
            "❌ Корзина пуста",
            reply_markup=InlineKeyboardMarkup([[
                InlineKeyboardButton("📦 В каталог", callback_data="catalog")
            ]])
        )
        return
    
    total_rub = sum(item['price'] for item in user_cart)
    
    if not CP_TOKEN:
        await query.edit_message_text(
            "❌ Оплата временно недоступна",
            reply_markup=InlineKeyboardMarkup([[
                InlineKeyboardButton("◀️ Назад", callback_data="cart")
            ]])
        )
        return
    
    usdt_amount = await rub_to_usdt(total_rub)
    current_rate = await get_usdt_rate()
    
    if usdt_amount < 0.1:
        min_rub = int(0.1 * current_rate)
        await query.edit_message_text(
            f"❌ Минимальная сумма заказа: 0.1 USDT (≈{min_rub} ₽)\n\n"
