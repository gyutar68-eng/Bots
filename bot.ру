    pending_orders[user_id].append({
        "order_id": order_id,
        "type": product_type,
        "quantity": quantity,
        "price_usd": price_usd,
        "status": "pending_payment",
        "date": datetime.now().isoformat()
    })
    
    # Конвертируем в USDT
    usdt_amount = await usd_to_usdt(price_usd)
    current_rate = await get_usdt_rate()
    
    if not CP_TOKEN:
        await query.edit_message_text(
            "❌ Оплата временно недоступна.\n\nПопробуйте позже или обратитесь к @YungTrezinny",
            reply_markup=InlineKeyboardMarkup([[
                InlineKeyboardButton("◀️ Назад", callback_data="catalog")
            ]])
        )
        return
    
    product_name = "ТЕСТОВЫЙ" if product_type == "test" else f"Подписи сим-карт {quantity} шт"
    description = f"{product_name} - заказ #{order_id} для user_{user_id}"
    
    invoice = await create_crypto_invoice(
        amount=usdt_amount,
        description=description,
        user_id=user_id
    )
    
    if invoice and invoice.get("pay_url"):
        # Сохраняем информацию об оплате
        if "pending_payments" not in context.user_data:
            context.user_data["pending_payments"] = []
        
        context.user_data["pending_payments"].append({
            "invoice_id": invoice["invoice_id"],
            "pay_url": invoice["pay_url"],
            "amount_usd": price_usd,
            "amount_usdt": usdt_amount,
            "quantity": quantity,
            "order_id": order_id,
            "user_id": user_id,
            "type": product_type,
            "status": "pending"
        })
        
        keyboard = [
