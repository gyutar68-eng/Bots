async def open_case(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    user_id = query.from_user.id
    
    if user_id in banned_users:
        await query.answer("⛔ Вы забанены!", show_alert=True)
        return
    
    case_id = query.data.replace("open_", "")
    case = CASES.get(case_id)
    
    if not case:
        return
    
    if case_id == 'free':
        last_open = case_cooldowns.get(user_id)
        if last_open:
            time_diff = datetime.now() - last_open
            if time_diff.days < 3:
                remaining = timedelta(days=3) - time_diff
                hours = remaining.seconds // 3600
                minutes = (remaining.seconds % 3600) // 60
                await query.answer(
                    f"⏳ Следующий бесплатный кейс через {hours}ч {minutes}м",
                    show_alert=True
                )
                return
    
    if case['price'] > 0:
        if user_balances.get(user_id, 0) < case['price']:
            await query.answer("❌ Недостаточно средств! Пополни баланс.", show_alert=True)
            return
        
        user_balances[user_id] -= case['price']
        
        transactions.append({
            'user_id': user_id,
            'type': 'case_purchase',
            'case': case['name'],
            'amount': case['price'],
            'date': datetime.now().isoformat()
        })
        
        if user_id not in user_stats:
            user_stats[user_id] = {'spent': 0, 'opened_cases': 0, 'won': 0, 'nickname': '', 'join_date': datetime.now().isoformat()}
        user_stats[user_id]['spent'] += case['price']
        user_stats[user_id]['opened_cases'] += 1
    
    # АНИМАЦИЯ
    animation_frames = [
        "🎲 Открываем кейс... ░░░░░░░░░░",
        "⚙️ Открываем кейс... █░░░░░░░░░",
        "🔄 Открываем кейс... ██░░░░░░░░",
        "🎰 Открываем кейс... ███░░░░░░░",
        "💫 Открываем кейс... ████░░░░░░",
        "✨ Открываем кейс... █████░░░░░",
        "🌟 Открываем кейс... ██████░░░░",
        "💥 Открываем кейс... ███████░░░",
    ]
    
    message = await query.edit_message_text(animation_frames[0])
    
    for i in range(1, len(animation_frames)):
        await asyncio.sleep(0.3)
        await message.edit_text(animation_frames[i])
    
    await asyncio.sleep(0.2)
    await message.edit_text("🔮 Выбираем приз... ████████░░")
    await asyncio.sleep(0.3)
    await message.edit_text("💎 Почти готово... █████████░")
    await asyncio.sleep(0.3)
    
    # ВЫБОР ВЫИГРЫША
    rand = random.random() * 100
    cumulative = 0
    win_amount = 0
    
    for item in case['real_items']:
        cumulative += item['chance']
        if rand <= cumulative:
            win_amount = item['amount']
            break
    
    user_balances[user_id] = user_balances.get(user_id, 0) + win_amount
    user_stats[user_id]['won'] += win_amount
    
    transactions.append({
        'user_id': user_id,
        'type': 'case_win',
        'case': case['name'],
        'amount': win_amount,
        'date': datetime.now().isoformat()
    })
    
    if case_id == 'free':
        case_cooldowns[user_id] = datetime.now()
    
    if win_amount >= case['price'] * 1.5:
        result_text = f"🎉🎉🎉 ДЖЕКПОТ! 🎉🎉🎉\n\nТы выиграл {win_amount}$!"
    elif win_amount > case['price']:
        result_text = f"🔥 УДАЧА! 🔥\n\nТы выиграл {win_amount}$!"
    elif win_amount == case['price']:
        result_text = f"🤝 Вернул своё 🤝\n\nВыигрыш: {win_amount}$"
    else:
        result_text = f"😢 Не в этот раз...\n\nВыигрыш: {win_amount}$"
    
    keyboard = [
        [InlineKeyboardButton("🎲 Открыть ещё", callback_data=f"case_{case_id}")],
        [InlineKeyboardButton("📦 Другие кейсы", callback_data="cases_menu")],
        [InlineKeyboardButton("👤 В профиль", callback_data="profile_menu")]
    ]
    reply_markup = InlineKeyboardMarkup(keyboard)
    
    await message.edit_text(
        f"{result_text}\n\n"
        f"💰 Твой баланс: {user_balances[user_id]}$",
        reply_markup=reply_markup
    )

