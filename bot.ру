        await message.edit_text(animation_frames[i])
    
    await asyncio.sleep(0.2)
    await message.edit_text("🔮 Выбираем приз... ████████░░")
    await asyncio.sleep(0.3)
    await message.edit_text("💎 Почти готово... █████████░")
    await asyncio.sleep(0.3)
    
    # ВЫБОР ВЫИГРЫША (по реальным шансам)
    rand = random.random() * 100
    cumulative = 0
    win_amount = 0
    
    for item in case['real_items']:
        cumulative += item['chance']
        if rand <= cumulative:
            win_amount = item['amount']
            break
    
    # Начисляем выигрыш
    user_balances[user_id] = user_balances.get(user_id, 0) + win_amount
    user_stats[user_id]['won'] += win_amount
    
    # Сохраняем транзакцию
    transactions.append({
        'user_id': user_id,
        'type': 'case_win',
        'case': case['name'],
        'amount': win_amount,
        'date': datetime.now().isoformat()
    })
    
    # Для бесплатного кейса устанавливаем кулдаун
    if case_id == 'free':
        case_cooldowns[user_id] = datetime.now()
    
    # ФИНАЛ
    if win_amount >= case['price'] * 1.5:  # Если выигрыш больше цены в 1.5 раза
        result_text = f"🎉🎉🎉 ДЖЕКПОТ! 🎉🎉🎉\n\nТы выиграл {win_amount}$!"
    elif win_amount > case['price']:
        result_text = f"🔥 УДАЧА! 🔥\n\nТы выиграл {win_amount}$!"
    elif win_amount == case['price']:
        result_text = f"🤝 Вернул своё 🤝\n\nВыигрыш: {win_amount}$"
    else:
        result_text = f"😢 Не в этот раз...\n\nВыигрыш: {win_amount}$"
    
    keyboard = [
        [InlineKeyboardButton("🎲 Открыть ещё", callback_data=f"case_{case_id}")],
        [InlineKeyboardButton("📦 Другие кейсы", callback_data="cases_menu")],
        [InlineKeyboardButton("👤 В профиль", callback_data="profile_menu")]
    ]
    reply_markup = InlineKeyboardMarkup(keyboard)
    
    await message.edit_text(
        f"{result_text}\n\n"
        f"💰 Твой баланс: {user_balances[user_id]}$",
        reply_markup=reply_markup
    )

