def main():
    persistence = PicklePersistence(filepath="bot_data.pkl")
    app = Application.builder().token(TOKEN).persistence(persistence).build()
    
    # ConversationHandler'ы
    nickname_handler = ConversationHandler(
        entry_points=[CallbackQueryHandler(change_nickname, pattern="^change_nickname$")],
        states={WAITING_FOR_NICKNAME: [MessageHandler(filters.TEXT & ~filters.COMMAND, set_nickname)]},
        fallbacks=[CommandHandler("cancel", cancel_input)],
        per_message=False
    )
    
    captcha_handler = ConversationHandler(
        entry_points=[CallbackQueryHandler(clicker_click, pattern="^clicker_click$")],
        states={WAITING_FOR_CAPTCHA: [MessageHandler(filters.TEXT & ~filters.COMMAND, handle_captcha_answer)]},
        fallbacks=[CommandHandler("cancel", cancel_input)],
        per_message=False
    )
    
    sim_seed_handler = ConversationHandler(
        entry_points=[
            CallbackQueryHandler(clicker_claim, pattern="^clicker_claim$"),
            CallbackQueryHandler(sim_select_operator, pattern="^sim_op_"),
            CallbackQueryHandler(sim_pay_balance, pattern="^sim_pay_balance$"),
            CallbackQueryHandler(sim_pay_crypto, pattern="^sim_pay_crypto$"),
            CallbackQueryHandler(check_sim_payment, pattern="^check_sim_payment_")
        ],
        states={WAITING_FOR_SIM_SEED: [MessageHandler(filters.TEXT & ~filters.COMMAND, handle_sim_seed)]},
        fallbacks=[CommandHandler("cancel", cancel_input)],
        per_message=False
    )
    
    sim_select_handler = ConversationHandler(
        entry_points=[CallbackQueryHandler(sim_select_quantity, pattern="^sim_qty_")],
        states={
            WAITING_FOR_SIM_OPERATOR: [CallbackQueryHandler(sim_select_operator, pattern="^sim_op_")]
        },
        fallbacks=[CommandHandler("cancel", cancel_input)],
        per_message=False
    )
    
    promo_user_handler = ConversationHandler(
        entry_points=[CallbackQueryHandler(activate_promo, pattern="^activate_promo$")],
        states={WAITING_FOR_PROMO_NAME: [MessageHandler(filters.TEXT & ~filters.COMMAND, process_promo)]},
        fallbacks=[CommandHandler("cancel", cancel_input)],
        per_message=False
