async def clicker_menu(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    
    user_id = query.from_user.id
    
    if user_id not in clicker_data:
        clicker_data[user_id] = {
            'clicks': 0,
            'last_reset': datetime.now(timezone.utc).isoformat(),
            'checkpoint': 0,
            'verification_pending': False
        }
    
    user_data = clicker_data[user_id]
    clicks = user_data['clicks']
    
    progress = int((clicks / CLICKS_REQUIRED) * 100)
    progress_bar = "▓" * (progress // 10) + "░" * (10 - (progress // 10))
    
    keyboard = [
        [InlineKeyboardButton("🖱 КЛИК!", callback_data="clicker_click")],
        [InlineKeyboardButton("◀️ Назад в меню", callback_data="back_to_menu")]
    ]
    
    if user_data.get('verification_pending', False):
        keyboard.insert(0, [InlineKeyboardButton("✅ ПРОВЕРКА", callback_data="clicker_verify")])
    
    reply_markup = InlineKeyboardMarkup(keyboard)
    
    await query.edit_message_text(
        f"🖱 КЛИКЕР\n\n"
        f"Прогресс: {progress_bar}\n"
        f"Клики: {clicks} / {CLICKS_REQUIRED} ({progress}%)\n\n"
        f"Цель: получить бесплатную подпись!",
        reply_markup=reply_markup
    )

async def clicker_click(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    
    user_id = query.from_user.id
    
    if user_id not in clicker_data:
        clicker_data[user_id] = {
            'clicks': 0,
            'last_reset': datetime.now(timezone.utc).isoformat(),
            'checkpoint': 0,
            'verification_pending': False
        }
    
    user_data = clicker_data[user_id]
    
    user_data['clicks'] += 1
    clicks = user_data['clicks']
    
    if clicks % CHECKPOINT_INTERVAL == 0 and clicks > 0:
        user_data['verification_pending'] = True
        
        num1 = random.randint(1, 10)
        num2 = random.randint(1, 10)
        captcha_answer = str(num1 + num2)
        
        context.user_data['captcha'] = {
            'question': f"{num1} + {num2} = ?",
            'answer': captcha_answer
        }
        
        await query.edit_message_text(
            f"🔐 ПРОВЕРКА\n\n"
            f"Вы накликали {clicks} кликов. Докажите что вы не бот.\n\n"
            f"Вопрос: {num1} + {num2} = ?\n\n"
            f"Напишите ответ в чат:",
            reply_markup=InlineKeyboardMarkup([[
                InlineKeyboardButton("◀️ Отмена", callback_data="clicker_menu")
            ]])
        )
        
        return WAITING_FOR_CAPTCHA
    
    clicker_data[user_id] = user_data
    await clicker_menu(update, context)
    return ConversationHandler.END

async def handle_captcha_answer(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    answer = update.message.text.strip()
    
    captcha = context.user_data.get('captcha', {})
    
    if answer == captcha.get('answer', ''):
        if user_id in clicker_data:
            clicker_data[user_id]['verification_pending'] = False
        
        context.user_data.pop('captcha', None)
        
        await update.message.reply_text("✅ Проверка пройдена! Продолжайте кликать.")
        
        fake_query = type('obj', (object,), {
            'from_user': type('obj', (object,), {'id': user_id}),
            'message': update.message,
            'answer': lambda: None
        })
        await clicker_menu(Update(update.update_id, callback_query=fake_query), context)
    else:
        await update.message.reply_text(
            f"❌ Неправильный ответ. Попробуйте снова.\n\n"
            f"Вопрос: {captcha.get('question', '')}\n"
            f"Напишите правильный ответ:"
        )
    
    return WAITING_FOR_CAPTCHA

