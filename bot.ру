            reply_markup=InlineKeyboardMarkup([[
                InlineKeyboardButton("◀️ Назад", callback_data="cart")
            ]])
        )
        return
    
    description = f"Заказ {user_id}"
    
    invoice = await create_crypto_invoice(
        amount=usdt_amount,
        description=description,
        user_id=user_id,
        context=context
    )
    
    if invoice and invoice.get("pay_url"):
        if "pending_payments" not in context.user_data:
            context.user_data["pending_payments"] = []
        
        payment_info = {
            "invoice_id": invoice["invoice_id"],
            "pay_url": invoice["pay_url"],
            "amount_rub": total_rub,
            "amount_usdt": usdt_amount,
            "rate": current_rate,
            "cart": user_cart.copy(),
            "user_id": user_id
        }
        context.user_data["pending_payments"].append(payment_info)
        
        keyboard = [
            [InlineKeyboardButton("💳 ОПЛАТИТЬ", url=invoice["pay_url"])],
            [InlineKeyboardButton("✅ Я ОПЛАТИЛ", callback_data=f"check_{invoice['invoice_id']}")],
            [InlineKeyboardButton("◀️ Отмена", callback_data="cart")]
        ]
