# ============================================
async def check_payment_callback(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    
    invoice_id = int(query.data.split("_")[1])
    user_id = query.from_user.id
    
    payment_info = None
    if "pending_payments" in context.user_data:
        for p in context.user_data["pending_payments"]:
            if p["invoice_id"] == invoice_id and p["user_id"] == user_id:
                payment_info = p
                break
    
    if not payment_info:
        await query.answer("❌ Платёж не найден", show_alert=True)
        return
    
    is_paid = await check_crypto_payment(invoice_id, user_id)
    
    if is_paid:
        await query.edit_message_text("✅ Платёж подтверждён! Формируем PDF...")
        
        order_id = len(orders.get(user_id, [])) + 1
        if user_id not in orders:
            orders[user_id] = []
        
        orders[user_id].append({
            "order_id": order_id,
            "items": payment_info["cart"],
            "total_rub": payment_info["amount_rub"],
            "total_usdt": payment_info["amount_usdt"],
            "status": "Оплачен",
            "date": datetime.now().isoformat()
        })
        
        quantity = payment_info["cart"][0]["quantity"] if payment_info["cart"] else 1
        pdf_path = await generate_logs_pdf(user_id, order_id, quantity)
        
        from telegram import FSInputFile
        document = FSInputFile(pdf_path)
        await context.bot.send_document(
            chat_id=user_id,
            document=document,
            caption=f"✅ Заказ #{order_id}\n\nЛоги ({quantity} шт)\nФайл содержит 200 записей.\n\nПоддержка: @shoplogs24support"
        )
        
        os.remove(pdf_path)
        
        carts[user_id] = []
        context.user_data["pending_payments"].remove(payment_info)
        
        await context.bot.send_message(
            chat_id=user_id,
            text=f"✅ Заказ выполнен! PDF отправлен.",
            reply_markup=InlineKeyboardMarkup([[
                InlineKeyboardButton("📦 В каталог", callback_data="catalog")
            ]])
        )
    else:
        await query.answer("⏳ Платёж не найден или не оплачен", show_alert=True)

