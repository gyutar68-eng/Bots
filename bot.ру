                CallbackQueryHandler(market_pay_commission_balance, pattern="^market_pay_commission_balance$"),
                CallbackQueryHandler(market_pay_commission_crypto, pattern="^market_pay_commission_crypto$"),
                CallbackQueryHandler(check_market_commission, pattern="^check_market_commission_")
