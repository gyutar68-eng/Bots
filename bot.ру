async def check_payment_callback(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    
    invoice_id = int(query.data.split("_")[2])
    user_id = query.from_user.id
    
    payment_info = None
    if "pending_payments" in context.user_data:
        for p in context.user_data["pending_payments"]:
            if p["invoice_id"] == invoice_id and p["user_id"] == user_id:
                payment_info = p
                break
    
    if not payment_info:
        await query.answer("❌ Платёж не найден", show_alert=True)
        return
    
    is_paid = await check_crypto_payment(invoice_id, user_id)
    
    if is_paid:
        # Обновляем статус заказа
        if user_id in pending_orders:
            for order in pending_orders[user_id]:
                if order.get("order_id") == payment_info.get("order_id"):
                    order["status"] = "paid"
                    break
        
        # Сохраняем информацию о заказе для ввода сид-фразы
        context.user_data["current_order"] = {
            "order_id": payment_info["order_id"],
            "type": "sim",
            "quantity": payment_info["quantity"],
            "user_id": user_id
        }
        
        keyboard = [[InlineKeyboardButton("❌ Отмена", callback_data="cancel_input")]]
        reply_markup = InlineKeyboardMarkup(keyboard)
        
        await query.edit_message_text(
            f"✅ Платёж подтверждён!\n\n"
            f"Теперь отправьте сид-фразу(ы) для сим-карт.\n\n"
            f"📌 ПРИМЕР сид-фразы (Мегафон):\n"
            f"`123456789012345678`\n\n"
            f"Если покупаете несколько штук, отправляйте каждую с новой строки.\n\n"
            f"Все данные будут переданы администратору @YungTrezinny.",
            reply_markup=reply_markup,
            parse_mode='Markdown'
        )
        
        # Удаляем информацию о платеже
        context.user_data["pending_payments"].remove(payment_info)
        
        # Переходим в режим ожидания ввода
        return WAITING_FOR_SIM_SEED
        
    else:
        await query.answer("⏳ Платёж не найден или не оплачен", show_alert=True)

